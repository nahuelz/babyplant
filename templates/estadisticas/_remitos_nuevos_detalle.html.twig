{% if detalle is empty %}
    <div class="text-center text-muted py-4">
        <i class="fas fa-inbox fa-2x mb-3"></i>
        <div>No hay remitos nuevos en este período</div>
    </div>
{% else %}
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
            <tr>
                <th>N° Remito</th>
                <th>Cliente</th>
                <th class="text-center">Monto total</th>
            </tr>
            </thead>
            <tbody>
            {% for remito in detalle %}
                <tr>
                    <td>
                        <a href="{{ path('remito_show', { id: remito.id }) }}">
                            N° {{ remito.id }}
                        </a>
                    </td>
                    <td>
                        <a href="{{ path('situacioncliente_show', { id: remito.cliente.id }) }}">
                            {{ remito.cliente }}
                        </a>
                    </td>
                    <td class="text-center">
                        {{ remito.totalConDescuento|money_format }}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    {% if total_paginas > 1 %}
        <nav class="mt-4">
            <ul class="pagination justify-content-center mb-0">
                {% if pagina_actual > 1 %}
                    <li class="page-item">
                        <a class="page-link js-remitos-nuevos-pagina" href="#" data-periodo="{{ periodo }}" data-pagina="{{ pagina_actual - 1 }}">&laquo;</a>
                    </li>
                {% endif %}

                {% for page in range(max(1, pagina_actual - 2), min(total_paginas, pagina_actual + 2)) %}
                    {% if page == pagina_actual %}
                        <li class="page-item active">
                            <span class="page-link">{{ page }}</span>
                        </li>
                    {% else %}
                        <li class="page-item">
                            <a class="page-link js-remitos-nuevos-pagina" href="#" data-periodo="{{ periodo }}" data-pagina="{{ page }}">{{ page }}</a>
                        </li>
                    {% endif %}
                {% endfor %}

                {% if pagina_actual < total_paginas %}
                    <li class="page-item">
                        <a class="page-link js-remitos-nuevos-pagina" href="#" data-periodo="{{ periodo }}" data-pagina="{{ pagina_actual + 1 }}">&raquo;</a>
                    </li>
                {% endif %}
            </ul>
        </nav>
    {% endif %}
{% endif %}
