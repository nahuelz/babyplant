{% extends 'base.html.twig' %}

{% block body %}

    <div class="card card-custom">
        <div class="card-header">
            <div class="card-title">
                <span class="card-icon"><i class="flaticon-search text-primary"></i></span>
                <h3 class="card-label">Resumen de liquidaciones — {{ periodo }}</h3>
            </div>
            <div class="card-toolbar">
                <form method="get" action="{{ path('liquidacion_index') }}" class="form-inline mr-3">
                    <div class="form-group mr-2">
                        <label for="periodo" class="mr-2">Período</label>
                        <input type="text" id="periodo" name="periodo" class="form-control" value="{{ periodo }}" required>
                    </div>
                    <div class="form-group mr-2">
                        <label for="empleado" class="mr-2">Empleado</label>
                        <select name="empleado" id="empleado" class="form-control choice" style="min-width: 220px;">
                            <option value="">Todos</option>
                            {% for emp in empleadosActivos %}
                                <option value="{{ emp.id }}" {{ empleadoId == emp.id ? 'selected' : '' }}>{{ emp.nombreCompleto }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="form-group mr-2">
                        <label for="modalidad" class="mr-2">Modalidad</label>
                        <select name="modalidad" id="modalidad" class="form-control choice" style="min-width: 160px;">
                            <option value="">Todas</option>
                            {% for mod in modalidades %}
                                <option value="{{ mod.id }}" {{ modalidadSeleccionada == mod.id ? 'selected' : '' }}>
                                    {{ mod.nombre }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                    <button type="submit" class="btn btn-light-primary font-weight-bold">Ver</button>
                </form>

                <form method="post" action="{{ path('liquidacion_generar') }}" class="form-inline mr-2" id="form-generar">
                    <input type="hidden" name="periodo" value="{{ periodo }}">
                    <input type="hidden" name="empleado" value="{{ empleadoId }}">
                    <input type="hidden" name="modalidad" value="{{ modalidadSeleccionada }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('generar_' ~ periodo) }}">
                    <button type="button" id="btn-generar" class="btn btn-primary font-weight-bold">
                        <i class="la la-plus"></i>
                        Generar liquidaciones
                    </button>
                </form>

                <a
                    href="{{ path('liquidacion_index_excel', {
                        'periodo': periodo,
                        'empleado': empleadoId,
                        'modalidad': modalidadSeleccionada
                    }) }}"
                    class="btn btn-success font-weight-bold"
                >
                    <i class="la la-file-excel"></i>
                    Exportar Excel
                </a>
            </div>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover table-checkable" id="table-liquidacion">
                    <thead>
                        <tr>
                            <th class="text-left">Empleado</th>
                            <th class="text-center">Modalidad</th>
                            {% for semana in semanas %}
                                <th class="text-center">Sem {{ semana.numero }}<br><small>{{ semana.label }}</small></th>
                            {% endfor %}
                            <th class="text-center">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for fila in grid %}
                            <tr style="
                                {% if fila.resumen and fila.resumen.estado %}
                                    {% if fila.resumen.estado.codigoInterno == constant('App\\Entity\\Constants\\ConstanteEstadoLiquidacion::APROBADA') %}background-color: #fff3cd;{% endif %}
                                    {% if fila.resumen.estado.codigoInterno == constant('App\\Entity\\Constants\\ConstanteEstadoLiquidacion::PAGADA') %}background-color: #d4edda;{% endif %}
                                {% endif %}
                            ">
                                <td>
                                    <a href="{{ path('app_empleado_show', {'id': fila.empleado.id}) }}" class="font-weight-bold">
                                        {{ fila.empleado.nombreCompleto }}
                                    </a>
                                </td>
                                <td class="text-center">{{ fila.modalidad }}</td>
                                {% for semana in fila.semanas %}
                                    <td class="text-center">
                                        {% if semana.liquidacion %}
                                            {% if fila.resumen and fila.resumen.estado and fila.resumen.estado.codigoInterno == constant('App\\Entity\\Constants\\ConstanteEstadoLiquidacion::APROBADA') %}
                                                <span class="font-weight-bold">{{ semana.valor }}</span>
                                            {% else %}
                                                <a href="#"
                                                   class="font-weight-bold abrir-modal-semana"
                                                   data-action="{{ path('liquidacion_guardar_semana', {'id': semana.liquidacion.id}) }}"
                                                   data-semana="{{ loop.index }}"
                                                   data-apellido="{{ fila.empleado.apellido }}"
                                                   data-nombre="{{ fila.empleado.nombre }}"
                                                   data-sueldo-bruto="{{ semana.liquidacion.sueldoBruto|replace({'.': ','}) }}"
                                                   data-deducciones="{{ semana.liquidacion.deducciones|replace({'.': ','}) }}"
                                                   data-token="{{ csrf_token('guardar_semana_' ~ semana.liquidacion.id) }}"
                                                   data-return="index">
                                                    {{ semana.valor }}
                                                </a>
                                            {% endif %}
                                        {% else %}
                                            <span class="text-muted">-</span>
                                        {% endif %}
                                    </td>
                                {% endfor %}
                                <td class="text-center font-weight-bold">
                                    {% if fila.resumen %}
                                        <a href="{{ path('liquidacion_show', {'id': fila.resumen.id}) }}" class="font-weight-bold">
                                            {{ fila.total }}
                                        </a>
                                    {% else %}
                                        {{ fila.total }}
                                    {% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="{{ 3 + semanas|length }}" class="text-center text-muted">No hay empleados activos con liquidaciones para este período.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                    <tfoot>
                        <tr class="font-weight-bold bg-light">
                            <th class="text-left">TOTAL</th>
                            <td></td>
                            {% for semana in semanas %}
                                <td class="text-center">
                                    $ {{ totales_semanas[loop.index0]|number_format(2, ',', '.') }}
                                </td>
                            {% endfor %}
                            <td class="text-center">
                                $ {{ total_general|number_format(2, ',', '.') }}
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <div class="card-footer d-flex justify-content-between">
            <a href="{{ path('empleado_index') }}" class="btn btn-light-dark font-weight-bold">Volver a empleados</a>
        </div>
    </div>

    {% include 'liquidacion/_modal_semana.html.twig' %}

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset(__PREFIX_JAVASCRIPT__ ~ 'app/liquidacion/index.js') }}"></script>
{% endblock %}
