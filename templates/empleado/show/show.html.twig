{% extends 'base.html.twig' %}

{% import 'app/_macro_show.html.twig' as macro_show %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .empleado-header {
            background: #fff;
            border: 1px solid #ebedf3;
            border-radius: 0.42rem;
            padding: 1.5rem;
            margin-bottom: 1.5rem;
        }
        .nav-tabs .nav-link {
            font-weight: 600;
        }
        .tarjeta-resumen {
            text-align: center;
            padding: 1.5rem;
        }
        .tarjeta-resumen .numero {
            font-size: 2.5rem;
            font-weight: 700;
        }
        .tarjeta-resumen .etiqueta {
            font-weight: 600;
            text-transform: uppercase;
        }
    </style>
{% endblock %}

{% block body %}

    <!-- Cabecera -->
    <div class="empleado-header d-flex align-items-center justify-content-between flex-wrap">
        <div class="d-flex align-items-center">
            <div class="symbol symbol-60 symbol-light-primary mr-5">
                <span class="symbol-label font-size-h3">{{ empleado.nombreCompleto|first|upper }}</span>
            </div>
            <div>
                <h3 class="mb-1">{{ empleado.nombreCompleto }}</h3>
                <span class="text-muted">DNI: {{ empleado.dni|default('-') }} · CUIL: {{ empleado.cuil|default('-') }}</span><br>
                <span class="text-muted">{{ empleado.categoria|default('-') }} · {{ empleado.modalidadPago|default('-') }}</span>
            </div>
        </div>
        <div class="d-flex align-items-center mt-3 mt-md-0">
            <a href="{{ path('app_empleado_edit', {'id': empleado.id}) }}" class="btn btn-primary mr-2">
                <i class="la la-pen"></i> Editar
            </a>
            <a href="{{ path('liquidacion_index') }}" class="btn btn-primary mr-2">
                <i class="la la-plus"></i> Nueva liquidación
            </a>
            <div class="dropdown">
                <button class="btn btn-light dropdown-toggle" type="button" data-toggle="dropdown">
                    Más
                </button>
                <div class="dropdown-menu dropdown-menu-right">
                    <a class="dropdown-item" href="#">Ver historial</a>
                    <form method="post" action="{{ path('app_empleado_activar_desactivar', {'id': empleado.id}) }}" class="dropdown-item-form d-inline w-100">
                        <input type="hidden" name="_token" value="{{ csrf_token('empleado_activar_desactivar_' ~ empleado.id) }}">
                        <button type="submit" class="dropdown-item text-left w-100" style="border: none; background: none;">
                            {{ empleado.activo ? 'Desactivar empleado' : 'Activar empleado' }}
                        </button>
                    </form>
                    <a class="dropdown-item" href="#">Exportar legajo</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabs -->
    <ul class="nav nav-tabs nav-tabs-line nav-tabs-line-2x mb-5" id="empleadoTabs" role="tablist">
        <li class="nav-item">
            <a class="nav-link active" data-toggle="tab" href="#tab-datos">Datos</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-toggle="tab" href="#tab-liquidaciones">Liquidaciones</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-toggle="tab" href="#tab-vacaciones">Vacaciones</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-toggle="tab" href="#tab-reportes">Reportes</a>
        </li>
    </ul>

    <div class="tab-content" id="empleadoTabsContent">
        {{ include('empleado/show/_tab_datos.html.twig') }}
        {{ include('empleado/show/_tab_liquidaciones.html.twig') }}
        {{ include('empleado/show/_tab_vacaciones.html.twig') }}
        {{ include('empleado/show/_tab_reportes.html.twig') }}
    </div>

    <div class="card-footer d-flex justify-content-between mt-5">
        <a href="{{ path('empleado_index') }}" class="btn btn-light-dark font-weight-bold">Volver al listado</a>
    </div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        function initTablaLiquidaciones() {
            try {
                if (!$.fn.DataTable || !$('#tabla-liquidaciones').length) {
                    return;
                }

                if ($.fn.DataTable.isDataTable('#tabla-liquidaciones')) {
                    $('#tabla-liquidaciones').DataTable().destroy();
                }

                $('#tabla-liquidaciones').DataTable({
                    responsive: true,
                    paging: false,
                    searching: false,
                    info: false,
                    ordering: true,
                    language: {
                        url: '//cdn.datatables.net/plug-ins/1.10.21/i18n/Spanish.json'
                    }
                });
            } catch (err) {
                console.error('Error al inicializar la tabla de liquidaciones', err);
            }
        }

        function refrescarPaneAjax(target, url) {
            var $pane = $(target);

            $.get(url, function (html) {
                var $doc = $($.parseHTML(html, document, false));
                var $nuevoContenido = $doc.find(target);

                if (!$nuevoContenido.length) {
                    $nuevoContenido = $doc.filter(target);
                }

                if ($nuevoContenido.length) {
                    $pane.html($nuevoContenido.html());
                }

                var $flash = $doc.find('#flash-messages-container');
                if ($flash.length) {
                    $('#flash-messages-container').html($flash.html());
                }

                initTablaLiquidaciones();

                if (typeof initSelects === 'function') {
                    initSelects();
                }

                $('[data-toggle="tooltip"]').tooltip();
                history.replaceState(null, '', url);
            });
        }

        $(document).on('submit', '.ajax-filter-form', function (e) {
            e.preventDefault();
            e.stopPropagation();

            var $form = $(this);
            var confirmMsg = $form.data('confirm');

            if (confirmMsg && !window.confirm(confirmMsg)) {
                return false;
            }

            var target = $form.data('ajaxTarget');
            var method = ($form.attr('method') || 'get').toUpperCase();

            if (method === 'GET') {
                refrescarPaneAjax(target, window.location.pathname + '?' + $form.serialize());
                return false;
            }

            $.post($form.attr('action'), $form.serialize()).always(function () {
                var anioField = $form.data('ajaxAnioField') || 'anio';
                var anioValor = $form.find('[name="' + anioField + '"]').val();
                var url = window.location.pathname + (anioValor ? '?anio=' + encodeURIComponent(anioValor) : '');

                refrescarPaneAjax(target, url);
            });

            return false;
        });

        $(function () {
            $('[data-toggle="tooltip"]').tooltip();

            initTablaLiquidaciones();

            const anioReporte = document.getElementById('anio-reporte');
            if (anioReporte) {
                anioReporte.addEventListener('change', function () {
                    const anio = this.value;

                    const urlReporte = '{{ path('app_empleado_reporte_anual', {
                        'id': empleado.id,
                        'anio': 9999
                    }) }}'.replace('/9999', '/' + anio);

                    const urlExcel = '{{ path('app_empleado_reporte_anual_excel', {
                        'id': empleado.id,
                        'anio': 9999
                    }) }}'.replace('/9999', '/' + anio);

                    document.getElementById('link-ver-reporte').href = urlReporte;
                    document.getElementById('link-exportar-excel').href = urlExcel;
                });
            }
        });
    </script>
{% endblock %}
