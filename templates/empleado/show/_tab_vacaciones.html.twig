<!-- TAB VACACIONES -->
<div class="tab-pane fade" id="tab-vacaciones">
    <div class="d-flex justify-content-between align-items-center mb-5 flex-wrap">
        <form method="get" class="form-inline mb-2 mb-md-0 ajax-filter-form no-spinner" data-ajax-target="#tab-vacaciones">
            <div class="form-group mr-3">
                <label for="anio-vacaciones" class="mr-2 font-weight-bold">Período</label>
                <select name="anio" id="anio-vacaciones" class="form-control choice">
                    {% for anio in aniosVacaciones %}
                        <option value="{{ anio }}" {{ anio == anioVacacionesSeleccionado ? 'selected' : '' }}>{{ anio }}</option>
                    {% else %}
                        <option value="{{ anioActual }}" selected>{{ anioActual }}</option>
                    {% endfor %}
                </select>
            </div>
            <button type="submit" class="btn btn-primary">Filtrar</button>
        </form>
        <div>
            <button class="btn btn-primary mr-2" data-toggle="collapse" data-target="#form-vacaciones">
                <i class="la la-plus"></i> Cargar / actualizar días correspondientes
            </button>
            <button class="btn btn-primary" data-toggle="collapse" data-target="#form-solicitud-vacaciones">
                <i class="la la-plus"></i> Registrar vacaciones tomadas
            </button>
        </div>
    </div>

    <div class="collapse mb-5" id="form-vacaciones">
        <div class="card card-custom">
            <div class="card-body">
                <form method="post" action="{{ path('app_empleado_vacaciones', {'id': empleado.id}) }}" class="form-inline ajax-filter-form no-spinner" data-ajax-target="#tab-vacaciones" data-ajax-anio-field="anio">
                    <div class="form-group mr-3">
                        <label for="anio" class="mr-2">Período</label>
                        <input type="number" name="anio" id="anio" class="form-control" value="{{ anioVacacionesSeleccionado }}" required>
                    </div>
                    <div class="form-group mr-3">
                        <label for="diasCorrespondientes" class="mr-2">Días que corresponden</label>
                        <input type="number" name="diasCorrespondientes" id="diasCorrespondientes" class="form-control" value="{{ vacaciones ? vacaciones.diasCorrespondientes : 0 }}" required>
                    </div>
                    <button type="submit" class="btn btn-primary font-weight-bold">Guardar</button>
                </form>
            </div>
        </div>
    </div>

    <div class="collapse mb-5" id="form-solicitud-vacaciones">
        <div class="card card-custom">
            <div class="card-body">
                <form method="post" action="{{ path('app_empleado_vacaciones_solicitud', {'id': empleado.id}) }}" class="form-row align-items-end ajax-filter-form no-spinner" data-ajax-target="#tab-vacaciones" data-ajax-anio-field="periodo">
                    <div class="form-group col-md-2">
                        <label for="periodo-solicitud">Período</label>
                        <input type="number" name="periodo" id="periodo-solicitud" class="form-control" value="{{ anioVacacionesSeleccionado }}" required>
                    </div>
                    <div class="form-group col-md-2">
                        <label for="fechaSolicitud">Fecha de solicitud</label>
                        <input type="date" name="fechaSolicitud" id="fechaSolicitud" class="form-control" required>
                    </div>
                    <div class="form-group col-md-2">
                        <label for="fechaDesde">Desde</label>
                        <input type="date" name="fechaDesde" id="fechaDesde" class="form-control" required>
                    </div>
                    <div class="form-group col-md-2">
                        <label for="fechaHasta">Hasta</label>
                        <input type="date" name="fechaHasta" id="fechaHasta" class="form-control" required>
                    </div>
                    <div class="form-group col-md-2">
                        <label for="fechaReincorporacion">Reincorporación</label>
                        <input type="date" name="fechaReincorporacion" id="fechaReincorporacion" class="form-control">
                    </div>
                    <div class="form-group col-md-1">
                        <label for="cantidadDias">Días</label>
                        <input type="number" name="cantidadDias" id="cantidadDias" class="form-control" step="0.5" min="0.5" required>
                    </div>
                    <div class="form-group col-md-1">
                        <button type="submit" class="btn btn-primary font-weight-bold w-100">Guardar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4 mb-5">
            <div class="card card-custom bg-light-info">
                <div class="card-body tarjeta-resumen">
                    <div class="numero">{{ diasCorrespondientesVacaciones }}</div>
                    <div class="etiqueta">Correspondientes</div>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-5">
            <div class="card card-custom bg-light-warning">
                <div class="card-body tarjeta-resumen">
                    <div class="numero">{{ diasTomadosVacaciones }}</div>
                    <div class="etiqueta">Tomadas</div>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-5">
            <div class="card card-custom bg-light-success">
                <div class="card-body tarjeta-resumen">
                    <div class="numero">{{ diasDisponiblesVacaciones }}</div>
                    <div class="etiqueta">Disponibles</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card card-custom">
        <div class="card-header">
            <h5 class="card-title">Historial de vacaciones tomadas del período {{ anioVacacionesSeleccionado }}</h5>
        </div>
        <div class="card-body">
            {% if solicitudesVacaciones|length > 0 %}
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Fecha solicitud</th>
                                <th>Desde</th>
                                <th>Hasta</th>
                                <th>Reincorporación</th>
                                <th class="text-right">Días tomados</th>
                                <th class="text-right">Días restantes del período</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for solicitud in solicitudesVacaciones %}
                                <tr>
                                    <td>{{ solicitud.fechaSolicitud|date('d/m/Y') }}</td>
                                    <td>{{ solicitud.fechaDesde|date('d/m/Y') }}</td>
                                    <td>{{ solicitud.fechaHasta|date('d/m/Y') }}</td>
                                    <td>{{ solicitud.fechaReincorporacion ? solicitud.fechaReincorporacion|date('d/m/Y') : '-' }}</td>
                                    <td class="text-right">{{ solicitud.cantidadDias }}</td>
                                    <td class="text-right">{{ solicitud.diasRestantesPeriodo }}</td>
                                    <td class="text-center">
                                        <a href="{{ path('app_empleado_vacaciones_solicitud_imprimir', {'id': empleado.id, 'solicitud': solicitud.id}) }}" target="_blank" class="btn btn-sm btn-light-primary mr-1" title="Imprimir">
                                            <i class="la la-print"></i>
                                        </a>
                                        <form method="post" action="{{ path('app_empleado_vacaciones_solicitud_eliminar', {'id': empleado.id, 'solicitud': solicitud.id}) }}" class="ajax-filter-form no-spinner d-inline" data-ajax-target="#tab-vacaciones" data-ajax-anio-field="periodo" data-confirm="¿Eliminar este registro de vacaciones?">
                                            <input type="hidden" name="periodo" value="{{ solicitud.periodo }}">
                                            <button type="submit" class="btn btn-sm btn-light-danger" title="Eliminar">
                                                <i class="la la-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <p class="text-muted mb-0">No hay vacaciones registradas para el período {{ anioVacacionesSeleccionado }}.</p>
            {% endif %}
        </div>
    </div>
</div>
