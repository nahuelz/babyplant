<!-- TAB LIQUIDACIONES -->
<div class="tab-pane fade" id="tab-liquidaciones">

    <div class="row mb-5">
        <div class="col-md-3 mb-4">
            <div class="card card-custom bg-light-info">
                <div class="card-body tarjeta-resumen">
                    <div class="numero">{{ resumenLiquidaciones.neto|money_format }}</div>
                    <div class="etiqueta">Neto</div>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-4">
            <div class="card card-custom bg-light-warning">
                <div class="card-body tarjeta-resumen">
                    <div class="numero">{{ resumenLiquidaciones.adicionales|money_format }}</div>
                    <div class="etiqueta">Adicionales</div>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-4">
            <div class="card card-custom bg-light-success">
                <div class="card-body tarjeta-resumen">
                    <div class="numero">{{ resumenLiquidaciones.aPagar|money_format }}</div>
                    <div class="etiqueta">Total a pagar</div>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-4">
            <div class="card card-custom bg-light-dark">
                <div class="card-body tarjeta-resumen">
                    <div class="numero">{{ resumenLiquidaciones.pagado|money_format }}</div>
                    <div class="etiqueta">Total pagado</div>
                </div>
            </div>
        </div>
    </div>

    {% set anioExport = anioSeleccionado > 0 ? anioSeleccionado : anioActual %}
    {% set mesExport = mesSeleccionado > 0 ? mesSeleccionado : ("now"|date("m")) %}
    {% set periodoExport = anioExport ~ '-' ~ ("%02d"|format(mesExport)) %}

    <div class="card card-custom">
        <div class="card-header d-flex justify-content-between align-items-center py-3">
            <h5 class="card-title m-0">Liquidaciones</h5>
            <a
                href="{{ path('liquidacion_index_excel', {
                    'periodo': periodoExport,
                    'empleado': empleado.id,
                    'modalidad': ''
                }) }}"
                class="btn btn-success font-weight-bold"
            >
                <i class="la la-file-excel"></i>
                Exportar Excel
            </a>
        </div>
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center flex-wrap">
                <div class="d-flex align-items-center flex-wrap mb-2 mb-md-0">
                    <span class="text-muted mr-3">
                        Modalidad de pago: <strong>{{ empleado.modalidadPago ? empleado.modalidadPago.nombre : '-' }}</strong>
                    </span>
                    <form method="get" class="form-inline ajax-filter-form no-spinner" data-ajax-target="#tab-liquidaciones">
                        <div class="form-group mr-2">
                            <label for="anio-liquidaciones" class="mr-2 font-weight-bold">Año</label>
                            <select name="anio" id="anio-liquidaciones" class="form-control choice">
                                <option value="0" {{ anioSeleccionado == 0 ? 'selected' : '' }}>Todos</option>
                                {% for anio in aniosDisponibles %}
                                    <option value="{{ anio }}" {{ anio == anioSeleccionado ? 'selected' : '' }}>{{ anio }}</option>
                                {% else %}
                                    <option value="{{ anioActual }}" selected>{{ anioActual }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="form-group mr-2">
                            <label for="mes-liquidaciones" class="mr-2 font-weight-bold">Mes</label>
                            <select name="mes" id="mes-liquidaciones" class="form-control choice">
                                <option value="0" {{ mesSeleccionado == 0 ? 'selected' : '' }}>Todos</option>
                                {% for numero, nombre in mesesDisponibles %}
                                    <option value="{{ numero|number_format(0) }}" {{ numero|number_format(0) == mesSeleccionado ? 'selected' : '' }}>{{ nombre }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <button type="submit" class="btn btn-primary">Filtrar</button>
                    </form>
                </div>
            </div>

            <hr class="my-4">

            {% if liquidaciones|length > 0 %}
                <div class="table-responsive">
                    <table class="table table-striped table-hover" id="tabla-liquidaciones">
                        <thead>
                            <tr>
                                <th>Período</th>
                                <th>Modalidad</th>
                                <th class="text-right">Bruto</th>
                                <th class="text-right">Deducciones</th>
                                <th class="text-right">Neto</th>
                                <th class="text-right">Adelantos</th>
                                <th class="text-right">Adicionales</th>
                                <th class="text-right">A pagar</th>
                                <th class="text-center">Estado</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for liquidacion in liquidaciones %}
                                {% set bruto = liquidacion.sueldoBruto %}
                                {% set deducciones = liquidacion.deducciones %}
                                {% set neto = liquidacion.sueldoNeto %}
                                {% set aPagar = liquidacion.totalAPagar %}
                                {% set fechaPago = liquidacion.pagos|length > 0 ? liquidacion.pagos|first.fecha : null %}

                                {% set adelantos = 0 %}
                                {% set adicionales = 0 %}
                                {% set detalleAdicionales = [] %}
                                {% for concepto in liquidacion.conceptos %}
                                    {% set tipo = concepto.tipoConceptoLiquidacion %}
                                    {% if tipo %}
                                        {% if tipo.esDescuento %}
                                            {% if tipo.codigoInterno == constant('App\\Entity\\Constants\\ConstanteTipoConceptoLiquidacion::ADELANTO') %}
                                                {% set adelantos = adelantos + concepto.importe %}
                                            {% endif %}
                                        {% else %}
                                            {% set adicionales = adicionales + concepto.importe %}
                                            {% set detalleAdicionales = detalleAdicionales|merge([{
                                                'nombre': tipo.nombre,
                                                'importe': concepto.importe
                                            }]) %}
                                        {% endif %}
                                    {% endif %}
                                {% endfor %}

                                {% set estadoCodigo = liquidacion.estado ? liquidacion.estado.codigoInterno : null %}
                                {% set estadoNombre = liquidacion.estado ? liquidacion.estado.nombre : 'Borrador' %}
                                {% set badgeClass = {
                                    (constant('App\\Entity\\Constants\\ConstanteEstadoLiquidacion::BORRADOR')): 'secondary',
                                    (constant('App\\Entity\\Constants\\ConstanteEstadoLiquidacion::CALCULADA')): 'info',
                                    (constant('App\\Entity\\Constants\\ConstanteEstadoLiquidacion::APROBADA')): 'primary',
                                    (constant('App\\Entity\\Constants\\ConstanteEstadoLiquidacion::PAGADA')): 'success',
                                    (constant('App\\Entity\\Constants\\ConstanteEstadoLiquidacion::ANULADA')): 'danger',
                                }[estadoCodigo]|default('secondary') %}

                                {% set tieneDetalles = liquidacion.detallesSemanales|length > 0 %}
                                <tr{% if tieneDetalles %} class="cursor-pointer" data-toggle="collapse" data-target="#detalle-liq-{{ liquidacion.id }}"{% endif %}>
                                    <td>
                                        {% if tieneDetalles %}
                                            <i class="la la-angle-right"></i>
                                        {% endif %}
                                        <div class="font-weight-bold">{{ liquidacion.fechaDesde|date('d/m/Y') }} - {{ liquidacion.fechaHasta|date('d/m/Y') }}</div>
                                        {% if fechaPago %}
                                            <small class="text-muted">Pago: {{ fechaPago|date('d/m/Y') }}</small>
                                        {% endif %}
                                    </td>
                                    <td>{{ liquidacion.tipoModalidadPago|default('-') }}</td>
                                    <td class="text-right">{{ bruto|money_format }}</td>
                                    <td class="text-right">{{ deducciones|money_format }}</td>
                                    <td class="text-right">{{ neto|money_format }}</td>
                                    <td class="text-right">{{ adelantos|money_format }}</td>
                                    <td class="text-right">
                                        {% if adicionales > 0 %}
                                            <span class="cursor-pointer" data-toggle="tooltip" data-html="true" title="
                                                <div class='text-left'>
                                                {% for detalle in detalleAdicionales %}
                                                    <div class='d-flex justify-content-between'>
                                                        <span>{{ detalle.nombre }}:</span>
                                                        <span class='ml-3'>{{ detalle.importe|money_format }}</span>
                                                    </div>
                                                {% endfor %}
                                                    <div class='d-flex justify-content-between border-top pt-1 mt-1'>
                                                        <span><strong>Total:</strong></span>
                                                        <span class='ml-3'><strong>{{ adicionales|money_format }}</strong></span>
                                                    </div>
                                                </div>
                                            ">
                                                {{ adicionales|money_format }}
                                            </span>
                                        {% else %}
                                            {{ adicionales|money_format }}
                                        {% endif %}
                                    </td>
                                    <td class="text-right font-weight-bold">{{ aPagar|money_format }}</td>
                                    <td class="text-center">
                                        <span class="badge badge-{{ badgeClass }}">{{ estadoNombre }}</span>
                                    </td>
                                    <td class="text-center">
                                        <a href="{{ path('liquidacion_show', {'id': liquidacion.id}) }}" class="btn btn-sm btn-light" title="Ver">
                                            <i class="la la-eye"></i>
                                        </a>
                                    </td>
                                </tr>

                                {% if tieneDetalles %}
                                    {% for semana in liquidacion.detallesSemanales %}
                                        {% set estadoSemanaCodigo = semana.estado ? semana.estado.codigoInterno : null %}
                                        {% set estadoSemanaNombre = semana.estado ? semana.estado.nombre : 'Borrador' %}
                                        {% set badgeSemanaClass = {
                                            (constant('App\\Entity\\Constants\\ConstanteEstadoLiquidacion::BORRADOR')): 'secondary',
                                            (constant('App\\Entity\\Constants\\ConstanteEstadoLiquidacion::CALCULADA')): 'info',
                                            (constant('App\\Entity\\Constants\\ConstanteEstadoLiquidacion::APROBADA')): 'primary',
                                            (constant('App\\Entity\\Constants\\ConstanteEstadoLiquidacion::PAGADA')): 'success',
                                            (constant('App\\Entity\\Constants\\ConstanteEstadoLiquidacion::ANULADA')): 'danger',
                                        }[estadoSemanaCodigo]|default('secondary') %}

                                        <tr class="collapse bg-light-secondary" id="detalle-liq-{{ liquidacion.id }}">
                                            <td class="pl-5"><small>{{ semana.fechaDesde|date('d/m/Y') }} - {{ semana.fechaHasta|date('d/m/Y') }}</small></td>
                                            <td><small>Semanal</small></td>
                                            <td class="text-right"><small>{{ semana.sueldoBruto|money_format }}</small></td>
                                            <td class="text-right"><small>{{ semana.deducciones|money_format }}</small></td>
                                            <td class="text-right"><small>{{ semana.sueldoNeto|money_format }}</small></td>
                                            <td class="text-right"><small>-</small></td>
                                            <td class="text-right"><small>-</small></td>
                                            <td class="text-right"><small>{{ semana.totalAPagar|money_format }}</small></td>
                                            <td class="text-center"><span class="badge badge-{{ badgeSemanaClass }}"><small>{{ estadoSemanaNombre }}</small></span></td>
                                            <td class="text-center">
                                                <a href="{{ path('liquidacion_show', {'id': semana.id}) }}" class="btn btn-sm btn-light" title="Ver">
                                                    <i class="la la-eye"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                {% endif %}
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <p class="text-muted mb-0">
                    No hay liquidaciones registradas
                    {% if anioSeleccionado > 0 %}
                        para {{ mesSeleccionadoNombre ? mesSeleccionadoNombre ~ ' de ' : '' }}{{ anioSeleccionado }}
                    {% elseif mesSeleccionadoNombre %}
                        para {{ mesSeleccionadoNombre }}
                    {% endif %}.
                </p>
            {% endif %}
        </div>
    </div>

</div>
