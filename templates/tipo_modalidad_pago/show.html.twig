{% extends 'base.html.twig' %}

{% import 'app/_macro_show.html.twig' as macro_show %}

{% block body %}

    <div class="card card-custom">
        <div class="card-header">
            <div class="card-title">
				<span class="card-icon">
					<i class="flaticon-search text-primary"></i>
				</span>
                <h3 class="card-label">Detalles de la modalidad de pago
                    {{ tipo_modalidad_pago }}</h3>
            </div>
            <div class="card-toolbar">
                <a href="{{ path('app_tipo_modalidad_pago_edit', {'id': tipo_modalidad_pago.id}) }}" class="btn btn-primary font-weight-bolder">
                    <i class="la la-pen"></i>
                    Editar
                </a>
            </div>
        </div>

        <div class="card-body">
            <div class="row">
                {{ macro_show._show_detail('Nombre', tipo_modalidad_pago.nombre, 'col-md-4') }}
                {{ macro_show._show_detail('Habilitado', tipo_modalidad_pago.habilitado == 1 ? 'Si' : 'No', 'col-md-4') }}
            </div>
        </div>
        <div class="card-footer d-flex justify-content-between">
            <a href="{{ path('tipomodalidadpago_index') }}" class="btn btn-light-dark font-weight-bold">Volver al listado</a>
        </div>

    </div>

{% endblock %}
