{% extends 'base.html.twig' %}

{% import 'app/_macro_form.html.twig' as macro_form %}
{% import 'app/_macro_show.html.twig' as macro_show %}

{% block body %}

    <div class="card card-custom">
        <div class="card-header">
            <div class="card-title">
                <span class="card-icon"><i class="flaticon-search text-primary"></i></span>
                <h3 class="card-label">Liquidación de {{ liquidacion.empleado.nombreCompleto }} — {{ liquidacion.periodo }}</h3>
            </div>
            <div class="card-toolbar">
                <span class="badge badge-info mr-3">{{ liquidacion.estado }}</span>
            </div>
        </div>

        <div class="card-body">
            <div class="row">
                {{ macro_show._show_detail('Empleado', liquidacion.empleado.nombreCompleto, 'col-md-4') }}
                {{ macro_show._show_detail('Período', liquidacion.periodo, 'col-md-2') }}
                {{ macro_show._show_detail('Desde', liquidacion.fechaDesde ? liquidacion.fechaDesde|date('d/m/Y') : '-', 'col-md-2') }}
                {{ macro_show._show_detail('Hasta', liquidacion.fechaHasta ? liquidacion.fechaHasta|date('d/m/Y') : '-', 'col-md-2') }}
                {{ macro_show._show_detail('Modalidad', liquidacion.tipoModalidadPago ? liquidacion.tipoModalidadPago.nombre : '-', 'col-md-2') }}
            </div>

            {% if liquidacion.detallesSemanales is not empty %}
                <h5 class="mt-8 mb-3">Semanas del mes</h5>
                <div class="table-responsive">
                    <table class="table table-bordered table-hover">
                        <thead>
                            <tr>
                                <th>Desde</th>
                                <th>Hasta</th>
                                <th class="text-right">Sueldo bruto</th>
                                <th class="text-right">Deducciones</th>
                                <th class="text-right">Sueldo neto</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for detalle in liquidacion.detallesSemanales %}
                                <tr>
                                    <td>{{ detalle.fechaDesde ? detalle.fechaDesde|date('d/m/Y') : '-' }}</td>
                                    <td>{{ detalle.fechaHasta ? detalle.fechaHasta|date('d/m/Y') : '-' }}</td>
                                    <td class="text-right">{{ detalle.sueldoBruto|number_format(2, ',', '.') }}</td>
                                    <td class="text-right">{{ detalle.deducciones|number_format(2, ',', '.') }}</td>
                                    <td class="text-right">{{ detalle.sueldoNeto|number_format(2, ',', '.') }}</td>
                                    <td>
                                        <a href="{{ path('liquidacion_show', {'id': detalle.id}) }}" class="btn btn-sm btn-light-primary font-weight-bold">Editar semana</a>
                                    </td>
                                </tr>
                            {% endfor %}
                            <tr class="font-weight-bold">
                                <td colspan="4" class="text-right">Total semanas</td>
                                <td class="text-right">{{ liquidacion.sueldoNeto|number_format(2, ',', '.') }}</td>
                                <td></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            {% endif %}

            {% if form %}
                {{ form_start(form, {'attr': {'class' : 'horizontal-form','novalidate': 'novalidate'} }) }}

                <div class="row mt-8">
                    {% if form.sueldoBruto is defined %}{{ macro_form._new_field(form.sueldoBruto, 'col-md-3') }}{% endif %}
                    {% if form.deducciones is defined %}{{ macro_form._new_field(form.deducciones, 'col-md-3') }}{% endif %}
                    {% if form.observaciones is defined %}{{ macro_form._new_field(form.observaciones, 'col-md-3') }}{% endif %}
                </div>

                {% if liquidacion.detallesSemanales is not empty %}
                    <input type="hidden" id="liquidacion_sueldoBruto" value="{{ liquidacion.sueldoNeto }}">
                    <input type="hidden" id="liquidacion_deducciones" value="0">
                {% endif %}

                {% if form.conceptos is defined %}
                    <h5 class="mt-8 mb-3">Conceptos</h5>

                    <div class="row row-liquidacion-concepto-form align-items-end">
                        <div class="col-md-2">
                            {{ macro_form._new_field(form.concepto.tipoConceptoLiquidacion, '') }}
                        </div>
                        <div class="col-md-3">
                            {{ macro_form._new_field(form.concepto.descripcion, '') }}
                        </div>
                        <div class="col-md-1">
                            {{ macro_form._new_field(form.concepto.cantidad, '') }}
                        </div>
                        <div class="col-md-2">
                            {{ macro_form._new_field(form.concepto.valorUnitario, '') }}
                        </div>
                        <div class="col-md-2">
                            {{ macro_form._new_field(form.concepto.importe, '') }}
                        </div>
                        <div class="col-md-2">
                            <div class="form-group">
                                <button type="button" class="btn btn-success font-weight-bold link-add-liquidacion-concepto">
                                    <i class="la la-plus"></i>
                                    AGREGAR CONCEPTO
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="row row-liquidacion-concepto-empty margin-top-20" style="display: none;">
                        <div class="col-md-12">
                            <div class="alert alert-danger alert-form-error" style="background-color: #fbe1e3;color: brown;">
                                Debe ingresar al menos un concepto.
                            </div>
                        </div>
                    </div>

                    <div class="row row-liquidacion-conceptos margin-top-15" style="{{ liquidacion.conceptos is empty ? 'display: none;' : '' }}">
                        <div class="col-md-12">
                            <div class="table-scrollable">
                                <table class="table table-striped table-bordered table-advance table-hover">
                                    <thead>
                                        <tr>
                                            <th class="text-center">Concepto</th>
                                            <th class="text-center">Descripción</th>
                                            <th class="text-center">Cantidad</th>
                                            <th class="text-center">Valor unitario</th>
                                            <th class="text-center">Importe</th>
                                            <th class="text-center">Tipo</th>
                                            <th class="nowrap text-center"></th>
                                        </tr>
                                    </thead>
                                    <tbody class="tbody-liquidacion-concepto" data-index="{{ liquidacion.conceptos|length }}">
                                        {% for concepto in liquidacion.conceptos %}
                                            <tr class="tr-liquidacion-concepto" data-total="{{ concepto.importe }}" data-tipo="{{ concepto.tipoConceptoLiquidacion.tipo }}">
                                                <td class="hidden">
                                                    <input type="hidden" name="liquidacion[conceptos][{{ loop.index0 }}][id]" value="{{ concepto.id }}">
                                                </td>
                                                <td class="hidden">
                                                    <input type="hidden" name="liquidacion[conceptos][{{ loop.index0 }}][tipoConceptoLiquidacion]" value="{{ concepto.tipoConceptoLiquidacion.id }}">
                                                </td>
                                                <td class="hidden">
                                                    <input type="hidden" name="liquidacion[conceptos][{{ loop.index0 }}][descripcion]" value="{{ concepto.descripcion }}">
                                                </td>
                                                <td class="hidden">
                                                    <input type="hidden" name="liquidacion[conceptos][{{ loop.index0 }}][cantidad]" value="{{ concepto.cantidad }}">
                                                </td>
                                                <td class="hidden">
                                                    <input type="hidden" name="liquidacion[conceptos][{{ loop.index0 }}][valorUnitario]" value="{{ concepto.valorUnitario|number_format(2, ',', '.') }}">
                                                </td>
                                                <td class="hidden">
                                                    <input type="hidden" name="liquidacion[conceptos][{{ loop.index0 }}][importe]" value="{{ concepto.importe|number_format(2, ',', '.') }}">
                                                </td>
                                                <td class="v-middle text-center">{{ concepto.tipoConceptoLiquidacion }}</td>
                                                <td class="v-middle text-center">{{ concepto.descripcion|default('-') }}</td>
                                                <td class="v-middle text-center">{{ concepto.cantidad|number_format(2, ',', '.') }}</td>
                                                <td class="v-middle text-center">$ {{ concepto.valorUnitario|number_format(2, ',', '.') }}</td>
                                                <td class="v-middle text-center">$ {{ concepto.importe|number_format(2, ',', '.') }}</td>
                                                <td class="v-middle text-center">{{ concepto.tipoConceptoLiquidacion.tipo }}</td>
                                                <td class="text-center v-middle">
                                                    <a href="#" class="btn btn-sm delete-link-inline link-delete-liquidacion-concepto tooltips" data-placement="top" data-original-title="Eliminar">
                                                        <i class="fa fa-trash text-danger"></i>
                                                    </a>
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                {% endif %}

                <div class="mt-3 font-weight-bold text-right">
                    Sueldo neto: <span id="resumen-neto"></span> &nbsp;|&nbsp;
                    Total a pagar: <span id="resumen-total"></span>
                </div>

                <div class="card-footer d-flex justify-content-between mt-8">
                    <a href="{{ path('liquidacion_index', {'periodo': liquidacion.periodo}) }}" class="btn btn-light-dark font-weight-bold">Volver</a>
                    <div>
                        {{ form_widget(form._token) }}
                        <button type="submit" class="btn btn-primary font-weight-bold mr-2">Guardar borrador</button>
                    </div>
                </div>

                {{ form_end(form, {'render_rest': false}) }}

                <div class="d-flex justify-content-end mt-3">
                    {#
                    {% if liquidacion.estado and liquidacion.estado.codigoInterno == 1 %}
                        <form method="post" action="{{ path('liquidacion_calcular', {'id': liquidacion.id}) }}" class="d-inline mr-2">
                            <input type="hidden" name="_token" value="{{ csrf_token('calcular_' ~ liquidacion.id) }}">
                            <button type="submit" class="btn btn-info font-weight-bold">Calcular</button>
                        </form>
                    {% endif %}
                    #}

                    {% if liquidacion.estado and liquidacion.estado.codigoInterno == 2 %}
                        <form method="post" action="{{ path('liquidacion_aprobar', {'id': liquidacion.id}) }}" class="d-inline mr-2">
                            <input type="hidden" name="_token" value="{{ csrf_token('aprobar_' ~ liquidacion.id) }}">
                            <button type="submit" class="btn btn-success font-weight-bold">Aprobar</button>
                        </form>
                    {% endif %}

                    {% if liquidacion.estado and liquidacion.estado.codigoInterno == 3 %}
                        <button type="button" class="btn btn-warning font-weight-bold mr-2" data-toggle="modal" data-target="#pagoModal">
                            <i class="la la-dollar-sign"></i>
                            Pagar
                        </button>
                    {% endif %}
                    {#
                    {% if liquidacion.estado and liquidacion.estado.codigoInterno != 5 %}
                        <form method="post" action="{{ path('liquidacion_anular', {'id': liquidacion.id}) }}" class="d-inline" id="form-anular">
                            <input type="hidden" name="_token" value="{{ csrf_token('anular_' ~ liquidacion.id) }}">
                            <input type="hidden" name="motivo" value="Anulación desde detalle">
                            <button type="submit" class="btn btn-danger font-weight-bold">Anular</button>
                        </form>
                    {% endif %}
                    #}
                </div>
            {% else %}
                <h5 class="mt-8 mb-3">Valores</h5>
                <div class="row">
                    {{ macro_show._show_detail('Sueldo bruto', liquidacion.sueldoBruto|number_format(2, ',', '.'), 'col-md-2') }}
                    {{ macro_show._show_detail('Deducciones', liquidacion.deducciones|number_format(2, ',', '.'), 'col-md-2') }}
                    {{ macro_show._show_detail('Sueldo neto', liquidacion.sueldoNeto|number_format(2, ',', '.'), 'col-md-2') }}
                    {{ macro_show._show_detail('Total a pagar', liquidacion.totalAPagar|number_format(2, ',', '.'), 'col-md-2') }}
                    {{ macro_show._show_detail('Total pagado', totalPagado|number_format(2, ',', '.'), 'col-md-2') }}
                    {{ macro_show._show_detail('Restante', restante|number_format(2, ',', '.'), 'col-md-2') }}
                </div>

                <h5 class="mt-8 mb-3">Conceptos</h5>
                <div class="table-responsive">
                    <table class="table table-bordered table-hover">
                        <thead>
                            <tr>
                                <th>Concepto</th>
                                <th>Descripción</th>
                                <th class="text-right">Cantidad</th>
                                <th class="text-right">Valor unitario</th>
                                <th class="text-right">Importe</th>
                                <th>Tipo</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for concepto in liquidacion.conceptos %}
                                <tr>
                                    <td>{{ concepto.tipoConceptoLiquidacion }}</td>
                                    <td>{{ concepto.descripcion|default('-') }}</td>
                                    <td class="text-right">{{ concepto.cantidad|number_format(2, ',', '.') }}</td>
                                    <td class="text-right">{{ concepto.valorUnitario|number_format(2, ',', '.') }}</td>
                                    <td class="text-right">{{ concepto.importe|number_format(2, ',', '.') }}</td>
                                    <td>{{ concepto.tipoConceptoLiquidacion.tipo }}</td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="6" class="text-center text-muted">Sin conceptos cargados.</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-end mt-3">
                    <a href="{{ path('liquidacion_index', {'periodo': liquidacion.periodo}) }}" class="btn btn-light-dark font-weight-bold">Volver</a>
                </div>
            {% endif %}

            {#
            <h5 class="mt-8 mb-3">Pagos registrados</h5>
            <div class="table-responsive">
                <table class="table table-bordered table-hover">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Modo</th>
                            <th>Comprobante</th>
                            <th class="text-right">Importe</th>
                            <th>Observaciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for pago in liquidacion.pagos %}
                            <tr>
                                <td>{{ pago.fecha ? pago.fecha|date('d/m/Y') : '-' }}</td>
                                <td>{{ pago.modoPago|default('-') }}</td>
                                <td>{{ pago.comprobante|default('-') }}</td>
                                <td class="text-right">{{ pago.importe|number_format(2, ',', '.') }}</td>
                                <td>{{ pago.observaciones|default('-') }}</td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" class="text-center text-muted">Sin pagos registrados.</td>
                            </tr>
                        {% endfor %}
                </table>
            </div>
            #}
        </div>
    </div>

    {#
    {% if liquidacion.estado and liquidacion.estado.codigoInterno == 3 %}
        <div class="modal fade" id="pagoModal" tabindex="-1" role="dialog" aria-labelledby="pagoModalLabel" aria-hidden="true">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="pagoModalLabel">Registrar pago</h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <i aria-hidden="true" class="ki ki-close"></i>
                        </button>
                    </div>
                    {{ form_start(pagoForm, {'attr': {'class' : 'horizontal-form','novalidate': 'novalidate'} }) }}
                    <div class="modal-body">
                        <div class="row">
                            {{ macro_form._new_field(pagoForm.importe, 'col-md-6') }}
                            {{ macro_form._new_field(pagoForm.fecha, 'col-md-6') }}
                        </div>
                        <div class="row">
                            {{ macro_form._new_field(pagoForm.modoPago, 'col-md-6') }}
                            {{ macro_form._new_field(pagoForm.comprobante, 'col-md-6') }}
                        </div>
                        <div class="row">
                            {{ macro_form._new_field(pagoForm.observaciones, 'col-md-12') }}
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light-primary font-weight-bold" data-dismiss="modal">Cerrar</button>
                        {{ form_widget(pagoForm._token) }}
                        <button type="submit" class="btn btn-success font-weight-bold">Registrar pago</button>
                    </div>
                    {{ form_end(pagoForm, {'render_rest': false}) }}
                </div>
            </div>
        </div>
    {% endif %}
    #}

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset(__PREFIX_JAVASCRIPT__ ~ 'app/liquidacion/show.js') }}"></script>
{% endblock %}
