{% import 'app/_macro_form.html.twig' as macro_form %}

{{ form_start(form, {'action': path('tarea_finalizar', {'id': tarea.id}), 'method': 'POST', 'attr': {'class': 'horizontal-form', 'novalidate': 'novalidate', 'id': 'form-avance-tarea'}}) }}
    {% include 'app/_fields_errors.html.twig' %}
    <div class="row">
        {{ macro_form._new_field(form.porcentajeAvance, 'col-md-4') }}
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="form-group">
                {{ form_label(form.observacionAvance) }}
                {{ form_widget(form.observacionAvance, {'attr': {'class': 'form-control', 'style': 'width: 100%; min-height: 120px;'}}) }}
            </div>
        </div>
    </div>
    <div class="text-right mt-3">
        <button type="button" class="btn btn-light-dark font-weight-bold" data-dismiss="modal">Cancelar</button>
        <button type="submit" class="btn btn-primary font-weight-bold">Registrar avance</button>
    </div>
{{ form_end(form) }}
