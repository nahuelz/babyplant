{% extends 'base.html.twig' %}
{% import 'app/_macro_show.html.twig' as macro_show %}

{% block stylesheets %}
    {{ parent() }}
    <style type="text/css">
        .card.card-detail .card-header {
            padding: 15px;
            background-color: #f5f5f5;
        }
        .card.card-detail {
            margin-bottom: 20px;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="card card-custom">
        <div class="card-header">
            <div class="card-title">
                <span class="card-icon"><i class="flaticon2-reload text-primary"></i></span>
                <h3 class="card-label">Reventa N° {{ entity.id }}</h3>
            </div>
        </div>
        <div class="card-body">

            <div class="card card-detail">
                <div class="card-header"><h4>Reventa</h4></div>
                <div class="card-body">
                    <div class="row">
                        {{ macro_show._show_detail('Estado', entity.estado.nombre|default('-'), 'col-md-4') }}
                        {{ macro_show._show_detail('Fecha Reventa', entity.fechaReventa is not null ? entity.fechaReventa|date('d/m/Y') : '-', 'col-md-4') }}
                        {{ macro_show._show_detail('Observación', entity.observacion|default('-'), 'col-md-4') }}
                    </div>
                    <div class="row">
                        {{ macro_show._show_detail('Cantidad de Bandejas', entity.cantidadBandejas|default('-'), 'col-md-6') }}
                        {{ macro_show._show_detail('Precio Unitario Original', '$ ' ~ entity.precioUnitarioOriginal|number_format(2, ',', '.')|default('-'), 'col-md-6') }}
                    </div>
                </div>
            </div>

            <div class="card card-detail">
                <div class="card-header"><h4>Clientes</h4></div>
                <div class="card-body">
                    <div class="row">
                        {% set clienteOriginalContent %}
                            {% if entity.clienteOriginal %}
                                <a href="{{ path('situacioncliente_show', {'id': entity.clienteOriginal.id}) }}">{{ entity.clienteOriginal }}</a>
                            {% else %}
                                -
                            {% endif %}
                        {% endset %}
                        {{ macro_show._show_detail('Cliente Original (devolvió)', clienteOriginalContent, 'col-md-6') }}

                        {% set clienteCompradorContent %}
                            {% if entity.cliente %}
                                <a href="{{ path('situacioncliente_show', {'id': entity.cliente.id}) }}">{{ entity.cliente }}</a>
                            {% else %}
                                -
                            {% endif %}
                        {% endset %}
                        {{ macro_show._show_detail('Cliente Comprador', clienteCompradorContent, 'col-md-6') }}
                    </div>
                </div>
            </div>

            <div class="card card-detail">
                <div class="card-header"><h4>Devolución origen</h4></div>
                <div class="card-body">
                    <div class="row align-items-center">
                        {% set devolucionContent %}
                            {% if entity.devolucion %}
                                <a href="{{ path('devolucion_show', {'id': entity.devolucion.id}) }}">{{ entity.devolucion }}</a>
                            {% else %}
                                -
                            {% endif %}
                        {% endset %}
                        {{ macro_show._show_detail('Devolución', devolucionContent, 'col-md-2') }}
                        <div class="d-flex flex-column font-weight-bold justify-content-center mr-5">
                            <span class="label label-inline font-weight-bold" style="min-width: 300px; padding: 20px; color: #fff; background-color: {{ entity.pedidoProducto.tipoProducto.color }}">{{ entity.pedidoProducto.productoBandeja }}</span>
                        </div>
                        {{ macro_show._show_detail('Origen Semilla', entity.pedidoProducto.tipoOrigenSemilla.nombre|default('-'), 'col-md-2') }}
                        {{ macro_show._show_detail('Bandejas devueltas', entity.devolucion.cantidadBandejas|default('-'), 'col-md-2') }}
                        {{ macro_show._show_detail('Disponibles en devolución', entity.devolucion.cantidadDisponible|default('-'), 'col-md-2') }}
                    </div>
                </div>
            </div>

            <div class="card card-detail">
                <div class="card-header"><h4>Entrega</h4></div>
                <div class="card-body">
                    <div class="row">
                        {% if entity.entrega %}
                            {% set entregaContent %}
                                <a href="{{ path('entrega_show', {'id': entity.entrega.id}) }}">{{ entity.entrega }}</a>
                            {% endset %}
                            {{ macro_show._show_detail('Entrega', entregaContent, 'col-md-4') }}
                            {{ macro_show._show_detail('Estado Entrega', entity.entrega.estado.nombre|default('-'), 'col-md-4') }}
                            {{ macro_show._show_detail('Fecha Entrega', entity.entrega.fechaEntrega is not null ? entity.entrega.fechaEntrega|date('d/m/Y') : '-', 'col-md-4') }}
                        {% else %}
                            <div class="col-md-12">
                                <p class="text-muted">La reventa aún no fue entregada.</p>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>

            <div class="card card-detail">
                <div class="card-header"><h4>Remito</h4></div>
                <div class="card-body">
                    <div class="row">
                        {% if entity.entrega and entity.entrega.remito %}
                            {{ macro_show._show_detail('Remito', entity.entrega.remito, 'col-md-4') }}
                            {{ macro_show._show_detail('Estado Remito', entity.entrega.remito.estado.nombre|default('-'), 'col-md-4') }}
                            {{ macro_show._show_detail('Fecha Remito', entity.entrega.remito.fechaCreacion is not null ? entity.entrega.remito.fechaCreacion|date('d/m/Y') : '-', 'col-md-4') }}
                            <div class="col-md-12"><hr></div>
                            {{ macro_show._show_detail('Cantidad de Bandejas', entity.entregaProducto.cantidadBandejas|default('-'), 'col-md-3') }}
                            {{ macro_show._show_detail('Precio Unitario', '$ ' ~ entity.entregaProducto.precioUnitario|number_format(2, ',', '.'), 'col-md-3') }}
                            {{ macro_show._show_detail('Descuento', '$ ' ~ entity.entregaProducto.montoDescuento|number_format(2, ',', '.'), 'col-md-3') }}
                            {{ macro_show._show_detail('Total', '$ ' ~ entity.entregaProducto.montoTotalConDescuento|number_format(2, ',', '.'), 'col-md-3') }}
                        {% else %}
                            <div class="col-md-12">
                                <p class="text-muted">La reventa aún no tiene remito.</p>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>

            <div class="card-footer d-flex justify-content-between">
                <a href="{{ path('reventa_index') }}" class="btn btn-light-dark font-weight-bold">Volver al listado</a>
            </div>
        </div>
    </div>
{% endblock %}
