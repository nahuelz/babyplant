<!-- TAB PRÉSTAMOS -->
<div class="tab-pane fade" id="tab-prestamos">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <h5 class="mb-0">Préstamos</h5>
        <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#modalNuevoPrestamo">
            <i class="la la-plus"></i> Registrar Préstamo
        </button>
    </div>

    <div class="card card-custom">
        <div class="card-body">
            {% if prestamos|length > 0 %}
                <div class="table-responsive">
                    <table class="table table-striped table-hover" style="table-layout: fixed; width: 100%;">
                        <thead>
                            <tr>
                                <th class="text-center align-middle" style="width: 25%;">Fecha Solicitud</th>
                                <th class="text-center align-middle" style="width: 25%;">Monto</th>
                                <th class="text-center align-middle" style="width: 25%;">Observaciones</th>
                                <th class="text-center align-middle" style="width: 25%;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for prestamo in prestamos %}
                                <tr>
                                    <td class="text-center align-middle">{{ prestamo.fecha|date('d/m/Y') }}</td>
                                    <td class="text-center align-middle font-weight-bold">{{ prestamo.monto|money_format }}</td>
                                    <td class="text-center align-middle text-break">{{ prestamo.observaciones|default('—') }}</td>
                                    <td class="text-center align-middle">
                                        <a href="{{ path('app_prestamo_imprimir', {'id': prestamo.id}) }}" target="_blank" class="btn btn-sm btn-light-primary mr-1" title="Imprimir">
                                            <i class="la la-print"></i>
                                        </a>
                                        <form method="post" action="{{ path('app_prestamo_delete', {'id': prestamo.id}) }}" class="d-inline" onsubmit="return confirm('¿Está seguro de eliminar este préstamo?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_prestamo_' ~ prestamo.id) }}">
                                            <button type="submit" class="btn btn-sm btn-light-danger" title="Eliminar">
                                                <i class="la la-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <p class="text-muted mb-0">No hay préstamos registrados para este empleado.</p>
            {% endif %}
        </div>
    </div>

    <!-- Modal Nuevo Préstamo -->
    <div class="modal fade" id="modalNuevoPrestamo" tabindex="-1" role="dialog" aria-labelledby="modalNuevoPrestamoLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                {{ form_start(formPrestamo, {'action': path('app_prestamo_new', {'id': empleado.id}), 'method': 'POST'}) }}
                <div class="modal-header">
                    <h5 class="modal-title" id="modalNuevoPrestamoLabel">Registrar Nuevo Préstamo</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <i aria-hidden="true" class="ki ki-close"></i>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        {{ form_label(formPrestamo.fecha) }}
                        {{ form_widget(formPrestamo.fecha) }}
                        {{ form_errors(formPrestamo.fecha) }}
                    </div>
                    <div class="form-group">
                        {{ form_label(formPrestamo.monto) }}
                        {{ form_widget(formPrestamo.monto) }}
                        {{ form_errors(formPrestamo.monto) }}
                    </div>
                    <div class="form-group">
                        {{ form_label(formPrestamo.observaciones) }}
                        {{ form_widget(formPrestamo.observaciones) }}
                        {{ form_errors(formPrestamo.observaciones) }}
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary font-weight-bold" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary font-weight-bold">Guardar Préstamo</button>
                </div>
                {{ form_end(formPrestamo) }}
            </div>
        </div>
    </div>
</div>
