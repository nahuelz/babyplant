{% extends 'base.html.twig' %}

{% import 'app/_macro_show.html.twig' as macro_show %}

{% block body %}
    <div class="card card-custom">
        <div class="card-header">
            <div class="card-title">
                <span class="card-icon"><i class="flaticon-search text-primary"></i></span>
                <h3 class="card-label">Tarea #{{ tarea.id }}</h3>
            </div>
        </div>

        <div class="card-body">
            <div class="row">
                {{ macro_show._show_detail('Descripción', tarea.descripcion|nl2br|default('-'), 'col-md-12') }}
            </div>
            <div class="row">
                {{ macro_show._show_detail('Estado', tarea.estado|default('-'), 'col-md-4') }}
                {% set nombresEmpleados = [] %}
                {% for empleado in tarea.empleados %}
                    {% set nombresEmpleados = nombresEmpleados|merge([empleado]) %}
                {% endfor %}
                {{ macro_show._show_detail('Empleados', nombresEmpleados|join(', ')|default('-'), 'col-md-4') }}
                {{ macro_show._show_detail('Creado por', tarea.usuarioCreacion|default('-'), 'col-md-4') }}
            </div>
            <div class="row">
                {{ macro_show._show_detail('Fecha creación', tarea.fechaCreacion ? tarea.fechaCreacion|date('d/m/Y H:i') : '-', 'col-md-4') }}
                {{ macro_show._show_detail('Fecha asignación', tarea.asignadoEn ? tarea.asignadoEn|date('d/m/Y H:i') : '-', 'col-md-4') }}
                {{ macro_show._show_detail('Fecha programada', tarea.fechaProgramada ? tarea.fechaProgramada|date('d/m/Y H:i') : '-', 'col-md-4') }}
            </div>
            <div class="row">
                {{ macro_show._show_detail('Fecha terminación', tarea.terminadoEn ? tarea.terminadoEn|date('d/m/Y H:i') : '-', 'col-md-4') }}
                {{ macro_show._show_detail('Fecha cancelación', tarea.canceladoEn ? tarea.canceladoEn|date('d/m/Y H:i') : '-', 'col-md-4') }}
            </div>

            <div class="row">
                {{ macro_show._show_detail('Avance', tarea.porcentajeAvance ~ '%', 'col-md-4') }}
                {{ macro_show._show_detail('Observación de avance', tarea.observacionAvance|default('-'), 'col-md-8') }}
            </div>

            {% if is_granted('ROLE_TAREA_ENCARGADO') %}
                <hr>

                <h5>Períodos de asignación</h5>
                <div class="table-responsive">
                    <table class="table table-bordered table-sm">
                        <thead>
                            <tr>
                                <th>Empleado</th>
                                <th>Inicio</th>
                                <th>Fin</th>
                                <th>Avance</th>
                                <th>Observación</th>
                                <th>Tiempo</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for asignacion in tarea.asignaciones %}
                            {% set segundos = asignacion.duracionSegundos %}
                            <tr>
                                <td>{{ asignacion.empleado }}</td>
                                <td>{{ asignacion.fechaInicio|date('d/m/Y H:i') }}</td>
                                <td>{{ asignacion.fechaFin ? asignacion.fechaFin|date('d/m/Y H:i') : 'Activo' }}</td>
                                <td>{{ asignacion.porcentajeAvance is not null ? asignacion.porcentajeAvance ~ '%' : '-' }}</td>
                                <td>{{ asignacion.observacionAvance|default('-') }}</td>
                                <td>{{ (segundos / 3600)|round(0, 'floor') }} h {{ ((segundos % 3600) / 60)|round(0, 'floor') }} min</td>
                            </tr>
                        {% else %}
                            <tr><td colspan="6" class="text-center">Sin períodos registrados</td></tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>

                <h6>Tiempo total por empleado</h6>
                <ul>
                    {% for total in tarea.duracionesTotalesPorEmpleado %}
                        <li>{{ total.empleado }}: {{ (total.segundos / 3600)|round(0, 'floor') }} h {{ ((total.segundos % 3600) / 60)|round(0, 'floor') }} min</li>
                    {% else %}
                        <li>Sin tiempos registrados</li>
                    {% endfor %}
                </ul>
            {% endif %}

        </div>

        <div class="card-footer d-flex justify-content-between">
            {% if is_granted('ROLE_TAREA_ENCARGADO') %}
                <a href="{{ path('tarea_index') }}" class="btn btn-light-dark font-weight-bold">Volver al listado</a>
            {% else %}
                <a href="{{ path('tarea_empleado_index') }}" class="btn btn-light-dark font-weight-bold">Volver</a>
            {% endif %}
        </div>
    </div>
{% endblock %}
