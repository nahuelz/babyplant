<!-- TAB REPORTES -->
<div class="tab-pane fade" id="tab-reportes">

    <div class="card card-custom">
        <div class="card-header">
            <div class="card-title">
                <h5 class="font-weight-bold mb-0">
                    Reporte anual de sueldos
                </h5>
            </div>
        </div>

        <div class="card-body">
            <p class="text-muted mb-5">
                Seleccione el año para consultar el resumen anual de sueldos del empleado.
            </p>

            <div class="form-row align-items-end">
                <div class="form-group col-md-3">
                    <label for="anio-reporte" class="font-weight-bold">Año</label>
                    <select
                        name="anio"
                        id="anio-reporte"
                        class="form-control choice"
                    >
                        {% for anio in aniosDisponibles %}
                            <option
                                value="{{ anio }}"
                                {{ anio == anioSeleccionado ? 'selected' : '' }}
                            >
                                {{ anio }}
                            </option>
                        {% else %}
                            <option value="{{ anioActual }}" selected>
                                {{ anioActual }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="form-group">
                    <a
                        id="link-ver-reporte"
                        href="{{ path('app_empleado_reporte_anual', {
                            'id': empleado.id,
                            'anio': anioSeleccionado > 0 ? anioSeleccionado : anioActual
                        }) }}"
                        class="btn btn-primary mr-2"
                    >
                        <i class="la la-file-alt"></i>
                        Ver reporte
                    </a>

                    <a
                        id="link-exportar-excel"
                        href="{{ path('app_empleado_reporte_anual_excel', {
                            'id': empleado.id,
                            'anio': anioSeleccionado > 0 ? anioSeleccionado : anioActual
                        }) }}"
                        class="btn btn-success"
                    >
                        <i class="la la-file-excel"></i>
                        Exportar Excel
                    </a>
                </div>
            </div>
        </div>
    </div>

</div>
