{% extends 'base.html.twig' %}
{% import 'app/_macro_show.html.twig' as macro_show %}

{% block stylesheets %}
    {{ parent() }}
    <style type="text/css">
        .card.card-detail .card-header {
            padding: 15px;
            background-color: #f5f5f5;
        }

        .card.card-detail {
            margin-bottom: 20px;
        }
    </style>
{% endblock %}

{% block body %}
    {% set producto = entity.entregaProducto.pedidoProducto %}
    {% set entrega = entity.entregaProducto.entrega %}
    {% set remito = entrega ? entrega.remito : null %}
    <div class="card card-custom">
        <div class="card-header">
            <div class="card-title">
                <span class="card-icon"><i class="flaticon2-refresh-1 text-primary"></i></span>
                <h3 class="card-label">Devolución N° {{ entity.id }}</h3>
            </div>
        </div>
        <div class="card-body">

            <div class="card card-detail">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">Devolución</h4>
                    <span class="label label-inline {{ entity.estado.color}} font-weight-bold p-4">
                        {{ entity.estado.nombre|default('-') }}
                    </span>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-md-3 mb-3">
                            <div class="card shadow-sm border-primary">
                                <div class="card-body py-4">
                                    <small class="font-size-16 text-uppercase">Devueltas</small>
                                    <div class="display-4 font-weight-bold text-primary">
                                        {{ entity.cantidadBandejas is not null ? entity.cantidadBandejas + 0 : '-' }}
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="card shadow-sm border-info">
                                <div class="card-body py-4">
                                    <small class="font-size-16 text-uppercase">Revendidas</small>
                                    <div class="display-4 font-weight-bold text-info">
                                        {{ entity.cantidadRevendida|default('-') }}
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="card shadow-sm border-danger">
                                <div class="card-body py-4">
                                    <small class="font-size-16 text-uppercase">Descartadas</small>
                                    <div class="display-4 font-weight-bold text-danger">
                                        {{ entity.cantidadDescartada|default('-') }}
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="card shadow-sm border-success">
                                <div class="card-body py-4">
                                    <small class="font-size-16 text-uppercase">Disponibles</small>
                                    <div class="display-4 font-weight-bold text-success">
                                        {{ entity.cantidadDisponible|default('-') }}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        {{ macro_show._show_detail('Cliente', entity.cliente|default('-'), 'col-md-6') }}
                        {{ macro_show._show_detail('Fecha Devolución', entity.fechaDevolucion is not null ? entity.fechaDevolucion|date('d/m/Y') : '-', 'col-md-4') }}
                    </div>
                    <div class="row">
                        {{ macro_show._show_detail('Precio Unitario', '$ ' ~ entity.precioUnitario|number_format(2, ',', '.')|default('-'), 'col-md-3') }}
                        {{ macro_show._show_detail('Valor Total', '$ ' ~ entity.valorTotal|number_format(2, ',', '.')|default('-'), 'col-md-3') }}
                    </div>
                    <div class="row">
                        {{ macro_show._show_detail('Observación / Motivo', entity.observacion|default('-'), 'col-md-12') }}
                    </div>
                    {% if entity.estado and entity.estado.codigoInterno == constant('App\\Entity\\Constants\\ConstanteEstadoDevolucion::CANCELADA') and entity.motivoCancelacion %}
                    <div class="row">
                        {{ macro_show._show_detail('Motivo de Cancelación', entity.motivoCancelacion, 'col-md-12') }}
                    </div>
                    {% endif %}
                </div>
            </div>

            <div class="card card-detail">
                <div class="card-header">
                    <div class="row">
                        <div class="col-md-6"><h4>Detalle</h4></div>
                        <div class="col-md-6 text-right">
                            <a href="{{ path('pedido_show', {'id': producto.pedido.id}) }}" class="btn btn-primary btn-sm">
                                <i class="fas fa-search"></i> VER PEDIDO
                            </a>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        {% set pedidoContent %}
                            <a href="{{ path('pedido_show', {'id': producto.pedido.id}) }}">{{ producto.pedido.id }}</a>
                        {% endset %}
                        {{ macro_show._show_detail('N° Pedido', pedidoContent, 'col-md-2') }}
                        <div class="d-flex flex-column font-weight-bold justify-content-center mr-5">
                            <span class="label label-inline font-weight-bold" style="min-width: 300px; padding: 20px; color: #fff; background-color: {{ producto.tipoProducto.color }}">{{ producto.productoBandeja }}</span>
                        </div>
                        {{ macro_show._show_detail('N° Orden', producto.getNumeroOrdenCompleto|default('-'), 'col-md-2') }}
                    </div>
                    <div class="row">
                        {% set entregaContent %}
                            <a href="{{ path('entrega_show', {'id': entrega.id}) }}">{{ entrega.id }}</a>
                        {% endset %}
                        {{ macro_show._show_detail('N° Entrega', entregaContent, 'col-md-2') }}
                        {{ macro_show._show_detail('Cantidad Bandejas Entregadas', entity.entregaProducto.cantidadBandejas|default('-'), 'col-md-2') }}
                        {{ macro_show._show_detail('Tiene Remito?', remito ? 'SI' : 'NO', 'col-md-2') }}
                        {% if remito %}
                            {% set remitoContent %}
                                <a href="{{ path('remito_show', {'id': remito.id}) }}">{{ remito.id }}</a>
                            {% endset %}
                            {{ macro_show._show_detail('N° Remito', remitoContent, 'col-md-2') }}
                            {{ macro_show._show_detail('Monto Total del Remito', remito.totalConDescuento|money_format, 'col-md-2') }}
                            {{ macro_show._show_detail('Estado del Remito', remito.estado.nombre|default('-'), 'col-md-2') }}
                        {% endif %}
                    </div>
                </div>
            </div>

            <div class="card-footer d-flex justify-content-between">
                <a href="{{ path('devolucion_index') }}" class="btn btn-light-dark font-weight-bold">Volver al listado</a>
                <div>
                    {% if entity.estado is null or entity.estado.codigoInterno != constant('App\\Entity\\Constants\\ConstanteEstadoDevolucion::CANCELADA') %}
                        {% if entity.cantidadDisponible > 0 %}
                            <a href="{{ path('reventa_new', {'devolucion': entity.id}) }}" class="btn btn-success font-weight-bold mr-2">
                                <i class="la la-dollar-sign"></i> Revender
                            </a>
                            <a href="{{ path('devolucion_descartar', {'id': entity.id}) }}" class="btn btn-danger font-weight-bold btn-descartar-devolucion">
                                <i class="la la-trash-alt"></i> Descartar
                            </a>
                        {% endif %}
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
