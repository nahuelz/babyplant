{% import 'app/_macro_show.html.twig' as macro_show %}

<!-- TAB DATOS -->
<div class="tab-pane fade show active" id="tab-datos">
    <div class="row">
        <div class="col-md-6 mb-5">
            <div class="card card-custom">
                <div class="card-header">
                    <h5 class="card-title">Datos personales</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        {{ macro_show._show_detail('Nombre', empleado.nombre, 'col-md-6') }}
                        {{ macro_show._show_detail('Apellido', empleado.apellido, 'col-md-6') }}
                        {{ macro_show._show_detail('Nacionalidad', empleado.nacionalidad|default('-'), 'col-md-6') }}
                        {{ macro_show._show_detail('DNI', empleado.dni, 'col-md-6') }}
                        {{ macro_show._show_detail('CUIL', empleado.cuil|default('-'), 'col-md-6') }}
                        {{ macro_show._show_detail('Teléfono', empleado.telefono|default('-'), 'col-md-6') }}
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-5">
            <div class="card card-custom">
                <div class="card-header">
                    <h5 class="card-title">Datos laborales</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        {{ macro_show._show_detail('Fecha de ingreso', empleado.fechaIngreso ? empleado.fechaIngreso|date('d/m/Y') : '-', 'col-md-6') }}
                        {{ macro_show._show_detail('Antigüedad', empleado.antiguedadTexto, 'col-md-6') }}
                        {{ macro_show._show_detail('Categoría', empleado.categoria|default('-'), 'col-md-6') }}
                        {{ macro_show._show_detail('Modalidad de pago', empleado.modalidadPago|default('-'), 'col-md-6') }}
                        {{ macro_show._show_detail('Obra social', empleado.obraSocial|default('-'), 'col-md-6') }}
                        {{ macro_show._show_detail('Banco', empleado.banco|default('-'), 'col-md-6') }}
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card card-custom">
                <div class="card-header d-flex justify-content-between align-items-center py-3">
                    <h5 class="card-title m-0">Observaciones</h5>
                    <a href="{{ path('app_empleado_edit', {'id': empleado.id}) }}" class="btn btn-xs btn-light-primary font-weight-bold">
                        <i class="la la-pen"></i> Editar
                    </a>
                </div>
                <div class="card-body">
                    <p class="text-muted">{{ empleado.observaciones ? empleado.observaciones|nl2br : 'Sin observaciones.' }}</p>
                </div>
            </div>
        </div>
    </div>
</div>
