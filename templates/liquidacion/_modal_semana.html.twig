<div class="modal fade" id="modalSemana" tabindex="-1" role="dialog" aria-labelledby="modalSemanaLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <form id="formGuardarSemana" method="post" action="">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalSemanaLabel">Liquidación semana</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <i aria-hidden="true" class="ki ki-close"></i>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label for="semana_sueldoBruto">Sueldo bruto</label>
                        <input type="text" id="semana_sueldoBruto" name="sueldoBruto" class="form-control" pattern="[0-9]+([,][0-9]+)?" required>
                    </div>
                    <div class="form-group">
                        <label for="semana_deducciones">Deducciones</label>
                        <input type="text" id="semana_deducciones" name="deducciones" class="form-control" pattern="[0-9]+([,][0-9]+)?" required>
                    </div>
                    <input type="hidden" name="_token" id="semana_token" value="">
                    <input type="hidden" name="return" id="semana_return" value="">
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light-dark font-weight-bold" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary font-weight-bold">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>
