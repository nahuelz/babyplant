<div class="row margin-left-20">
    <div class="col-xl-6">
        <div class="card card-custom card-stretch gutter-b bg-light-primary ">
            <div class="card-body d-flex align-items-center py-0 primary ">
                <i class="fas fa-tasks icon-3x text-dark mr-15"></i>
                <div class="d-flex flex-column flex-grow-1 py-2 py-lg-5">
                    <a href="#" id="tile-total-tareas" class="card-title font-weight-bolder text-dark-75 font-size-h2 mb-2 text-hover-primary">{{ indicadorTareaData.total }}</a>
                    <span class="font-weight-bold text-dark  font-size-lg">Total tareas</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-6">
        <div class="card card-custom card-stretch gutter-b bg-light-success ">
            <div class="card-body d-flex align-items-center py-0 success ">
                <i class="fas fa-user-check icon-3x text-dark mr-15"></i>
                <div class="d-flex flex-column flex-grow-1 py-2 py-lg-5">
                    <a href="#" id="tile-tareas-asignadas" class="card-title font-weight-bolder text-dark-75 font-size-h2 mb-2 text-hover-primary">{{ indicadorTareaData.asignadas }}</a>
                    <span class="font-weight-bold text-dark  font-size-lg">Tareas asignadas</span>
                </div>
            </div>
        </div>
    </div>
</div>
