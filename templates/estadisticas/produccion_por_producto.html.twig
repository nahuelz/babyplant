{% extends 'base.html.twig' %}

{% block title %}Estadísticas · Producción por Producto{% endblock %}

{% block body %}
    <div class="container mt-4">

        <div class="mb-4">
            <h2 class="fw-bold">🌱 Producción por producto</h2>
            <p class="text-muted mb-0">
                Total de bandejas elaboradas por tipo de producto
            </p>
        </div>

        {# Filtros #}
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <form method="get" class="row g-3 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label">Desde</label>
                        <input type="date"
                               name="desde"
                               class="form-control"
                               value="{{ desde|date('Y-m-d') }}">
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Hasta</label>
                        <input type="date"
                               name="hasta"
                               class="form-control"
                               value="{{ hasta|date('Y-m-d') }}">
                    </div>

                    <div class="col-md-4 d-flex gap-2">
                        <button class="btn btn-primary w-100">
                            Filtrar
                        </button>
                        <a href="{{ path('estadisticas_produccion_producto') }}"
                           class="btn btn-outline-secondary w-100">
                            Limpiar
                        </a>
                    </div>
                </form>
            </div>
        </div>

        {# Tabla #}
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                    <tr>
                        <th>Producto</th>
                        <th class="text-end">Total plantas elaboradas</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% if resultados is empty %}
                        <tr>
                            <td colspan="2" class="text-center text-muted py-4">
                                No hay producción en el rango seleccionado
                            </td>
                        </tr>
                    {% else %}
                        {% for row in resultados %}
                            {% set porcentaje = total_general > 0 ? (row.totalPlantas / total_general) * 100 : 0 %}
                            <tr>
                                <td>
                                    <a href="#detalle-{{ loop.index }}"
                                       class="text-decoration-none text-dark d-flex align-items-center"
                                       data-toggle="collapse"
                                       aria-expanded="false"
                                       aria-controls="detalle-{{ loop.index }}">
                                        <span class="me-2 toggle-icon" style="display:inline-block;width:1em;">▶</span>
                                        <strong>{{ row.producto }}</strong>
                                    </a>
                                </td>
                                <td class="text-end">
                                <span class="badge bg-success fs-6">
                                    {{ row.totalPlantas|round|number_format(0, ",", ".") }} ({{ porcentaje|number_format(2, ",", ".") }}%)
                                </span>
                                </td>
                            </tr>
                            <tr class="collapse" id="detalle-{{ loop.index }}">
                                <td colspan="2" class="p-0 bg-light">
                                    <div class="p-3">
                                        <table class="table table-sm table-hover table-bordered mb-0">
                                            <thead class="table-secondary">
                                                <tr>
                                                    <th class="ps-4">Variedad / Subproducto</th>
                                                    <th class="text-end pe-3">Plantas</th>
                                                    <th class="text-end pe-3" style="width: 110px;">%</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                            {% for detalle in detalles_agrupados[row.producto]|default([]) %}
                                                {% set porcentajeDetalle = row.totalPlantas > 0 ? (detalle.totalPlantas / row.totalPlantas) * 100 : 0 %}
                                                <tr>
                                                    <td class="ps-4">{{ detalle.subProducto }}</td>
                                                    <td class="text-end pe-3">
                                                        {{ detalle.totalPlantas|round|number_format(0, ",", ".") }}
                                                    </td>
                                                    <td class="text-end pe-3">
                                                        <span class="badge bg-info text-dark">
                                                            {{ porcentajeDetalle|number_format(2, ",", ".") }}%
                                                        </span>
                                                    </td>
                                                </tr>
                                            {% else %}
                                                <tr>
                                                    <td colspan="3" class="text-center text-muted py-2">
                                                        Sin detalles
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                            </tbody>
                                        </table>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    {% endif %}
                    </tbody>

                    {% if resultados is not empty %}
                        <tfoot class="table-light">
                        <tr>
                            <th>Total general</th>
                            <th class="text-end">
                                {{ total_general|round|number_format(0, ",", ".") }}
                            </th>
                        </tr>
                        </tfoot>
                    {% endif %}
                </table>
            </div>
        </div>

    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        $(document).on('shown.bs.collapse', function (e) {
            $('[href="#' + e.target.id + '"]').find('.toggle-icon').text('▼');
        });
        $(document).on('hidden.bs.collapse', function (e) {
            $('[href="#' + e.target.id + '"]').find('.toggle-icon').text('▶');
        });
    </script>
{% endblock %}
