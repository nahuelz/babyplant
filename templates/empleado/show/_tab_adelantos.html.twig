<!-- TAB ADELANTOS -->
<div class="tab-pane fade" id="tab-adelantos">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <h5 class="mb-0">Adelantos</h5>
        <button class="btn btn-primary" disabled title="Próximamente">
            <i class="la la-plus"></i> Registrar adelanto
        </button>
    </div>
    <div class="card card-custom">
        <div class="card-body">
            {% if adelantos|length > 0 %}
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th class="text-right">Importe</th>
                            <th>Liquidación</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for adelanto in adelantos %}
                            <tr>
                                <td>{{ adelanto.fecha|date('d/m/Y') }}</td>
                                <td class="text-right">{{ adelanto.importe|money_format }}</td>
                                <td>{{ adelanto.liquidacion ? adelanto.liquidacion : '—' }}</td>
                                <td>
                                    <span class="badge badge-{{ adelanto.imputado ? 'success' : 'warning' }}">
                                        {{ adelanto.imputado ? 'Imputado' : 'Pendiente' }}
                                    </span>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% else %}
                <p class="text-muted mb-0">No hay adelantos registrados.</p>
            {% endif %}
        </div>
    </div>
</div>
