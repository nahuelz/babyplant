{% if detalle is empty %}
    <div class="text-center text-muted py-4">
        <i class="fas fa-inbox fa-2x mb-3"></i>
        <div>No hay pedidos nuevos en este período</div>
    </div>
{% else %}
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
            <tr>
                <th>N° Pedido</th>
                <th>Producto</th>
                <th class="text-center">Cantidad de bandejas</th>
                <th>Cliente</th>
            </tr>
            </thead>
            <tbody>
            {% for fila in detalle %}
                <tr>
                    <td>
                        <a href="{{ path('pedido_show', { id: fila.idPedido }) }}">
                            N° {{ fila.idPedido }}
                        </a>
                    </td>
                    <td>
                        <span class="label label-inline font-weight-bold p-6"
                              style="font-size: 11px; color: black !important; background-color: {{ fila.colorProducto }}">
                            {{ fila.producto }}
                        </span>
                    </td>
                    <td class="text-center">
                        {{ fila.cantidadBandejasPedidas|default(0) }} (x{{ fila.tipoBandeja }})
                    </td>
                    <td>
                        <a href="{{ path('situacioncliente_show', { id: fila.idCliente }) }}">
                            {{ fila.cliente }}
                        </a>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    {% if total_paginas > 1 %}
        <nav class="mt-4">
            <ul class="pagination justify-content-center mb-0">
                {% if pagina_actual > 1 %}
                    <li class="page-item">
                        <a class="page-link js-pedidos-nuevos-pagina" href="#" data-periodo="{{ periodo }}" data-pagina="{{ pagina_actual - 1 }}">&laquo;</a>
                    </li>
                {% endif %}

                {% for page in range(max(1, pagina_actual - 2), min(total_paginas, pagina_actual + 2)) %}
                    {% if page == pagina_actual %}
                        <li class="page-item active">
                            <span class="page-link">{{ page }}</span>
                        </li>
                    {% else %}
                        <li class="page-item">
                            <a class="page-link js-pedidos-nuevos-pagina" href="#" data-periodo="{{ periodo }}" data-pagina="{{ page }}">{{ page }}</a>
                        </li>
                    {% endif %}
                {% endfor %}

                {% if pagina_actual < total_paginas %}
                    <li class="page-item">
                        <a class="page-link js-pedidos-nuevos-pagina" href="#" data-periodo="{{ periodo }}" data-pagina="{{ pagina_actual + 1 }}">&raquo;</a>
                    </li>
                {% endif %}
            </ul>
        </nav>
    {% endif %}
{% endif %}
