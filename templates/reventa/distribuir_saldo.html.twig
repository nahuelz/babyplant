<form id="form-distribuir-saldo-reventa">
    <input type="hidden" name="_token" value="{{ csrf_token('distribuir_saldo_' ~ reventa.id) }}">
    <input type="hidden" name="token" value="{{ token }}">
    <input type="hidden" id="distribucion_total" value="{{ total }}">

    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <label>Reventa</label>
                <input type="text" class="form-control" value="N° {{ reventa.id }}" readonly>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label>Remito</label>
                <input type="text" class="form-control" value="N° {{ reventa.entrega.remito.id }}" readonly>
            </div>
        </div>
        <div class="col-md-12">
            <div class="form-group">
                <label>Cliente original</label>
                <input type="text" class="form-control" value="{{ reventa.clienteOriginal }}" readonly>
            </div>
        </div>
        <div class="col-md-12">
            <div class="form-group">
                <label>Valor total reventa</label>
                <input type="text" class="form-control font-weight-bold" value="$ {{ total|number_format(2, ',', '.') }}" readonly>
            </div>
        </div>
        <div class="col-md-12">
            <div class="form-group">
                <label for="modo_pago_reventa">Modo de pago</label>
                <select name="modoPago" id="modo_pago_reventa" class="form-control" required>
                    <option value="">-- Seleccione --</option>
                    {% for codigo, nombre in modosPago %}
                        <option value="{{ codigo }}">{{ nombre }}</option>
                    {% endfor %}
                </select>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label for="monto_cliente_original">Total a enviar a la cuenta corriente</label>
                <input type="text" id="monto_cliente_original" name="montoClienteOriginal" class="form-control" value="{{ montoClienteOriginal|number_format(2, ',', '') }}" required>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label for="monto_plantinera">Caja de la plantinera</label>
                <input type="text" id="monto_plantinera" name="montoPlantinera" class="form-control" value="{{ montoPlantinera|number_format(2, ',', '') }}" required readonly>
            </div>
        </div>
    </div>
</form>
