{% extends 'base.html.twig' %}

{% import 'app/_macro_form.html.twig' as macro_form %}
{% import 'app/_macro_show.html.twig' as macro_show %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .liquidacion-header {
            background: #fff;
            border: 1px solid #ebedf3;
            border-radius: 0.42rem;
            padding: 1.5rem;
            margin-bottom: 1.5rem;
        }
    </style>
{% endblock %}

{% block body %}

    <div class="card card-custom">
        <div class="card-header">
            <div class="card-title">
                <span class="card-icon"><i class="flaticon-search text-primary"></i></span>
                <h3 class="card-label">Liquidación de {{ liquidacion.empleado.nombreCompleto }} — {{ liquidacion.periodo }}</h3>
            </div>
            <div class="card-toolbar">
                <a href="{{ path('liquidacion_index_excel', {
                    'periodo': liquidacion.periodo,
                    'empleado': liquidacion.empleado.id,
                    'modalidad': liquidacion.tipoModalidadPago ? liquidacion.tipoModalidadPago.id : ''
                }) }}" class="btn btn-success font-weight-bold mr-3">
                    <i class="la la-file-excel"></i> Exportar Excel
                </a>
                <span class="badge badge-info mr-3">{{ liquidacion.estado }}</span>
            </div>
        </div>

        <div class="card-body">

            <!-- Cabecera -->
            <div class="liquidacion-header d-flex align-items-center justify-content-between flex-wrap">
                <div class="d-flex align-items-center">
                    <div class="symbol symbol-60 symbol-light-primary mr-5">
                        <span class="symbol-label font-size-h3">{{ liquidacion.empleado.nombreCompleto|first|upper }}</span>
                    </div>
                    <div>
                        <h3 class="mb-1">{{ liquidacion.empleado.nombreCompleto }}</h3>
                        <span class="text-muted">Período: {{ liquidacion.periodo }}</span><br>
                        <span class="text-muted">Desde: {{ liquidacion.fechaDesde ? liquidacion.fechaDesde|date('d/m/Y') : '-' }} · Hasta: {{ liquidacion.fechaHasta ? liquidacion.fechaHasta|date('d/m/Y') : '-' }}</span><br>
                        <span class="text-muted">Modalidad: {{ liquidacion.tipoModalidadPago ? liquidacion.tipoModalidadPago.nombre : '-' }}</span>
                    </div>
                </div>
                <div class="d-flex align-items-center mt-3 mt-md-0">
                    <a href="{{ path('app_empleado_show', {'id': liquidacion.empleado.id}) }}" class="btn btn-primary">
                        <i class="la la-user"></i> Ver empleado
                    </a>
                </div>
            </div>

            {% if liquidacion.detallesSemanales is not empty %}
                <h5 class="mt-8 mb-3">Semanas del mes</h5>
                <div class="table-responsive">
                    <table class="table table-bordered table-hover">
                        <thead>
                            <tr>
                                <th class="text-center">Semana</th>
                                <th class="text-center">Sueldo bruto</th>
                                <th class="text-center">Deducciones</th>
                                <th class="text-center">Sueldo neto</th>
                                <th class="text-center">Conceptos</th>
                                <th class="text-center">Estado</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for detalle in liquidacion.detallesSemanales %}
                                <tr>
                                    <td class="text-center">
                                        {% if detalle.fechaDesde and detalle.fechaHasta %}
                                            {{ detalle.fechaDesde|date('d/m') }} - {{ detalle.fechaHasta|date('d/m') }}
                                        {% else %}
                                            -
                                        {% endif %}
                                    </td>
                                    <td class="text-center">{{ detalle.sueldoBruto|money_format }}</td>
                                    <td class="text-center">{{ detalle.deducciones|money_format }}</td>
                                    <td class="text-center">{{ detalle.sueldoNeto|money_format }}</td>
                                    <td class="text-center">{{ detalle.totalConceptos|money_format }}</td>
                                    <td class="text-center">
                                        {% if detalle.estado %}
                                            {% set estadoColor = '' %}
                                            {% if detalle.estado.codigoInterno == constant('App\\Entity\\Constants\\ConstanteEstadoLiquidacion::APROBADA') %}
                                                {% set estadoColor = '#fff3cd' %}
                                            {% elseif detalle.estado.codigoInterno == constant('App\\Entity\\Constants\\ConstanteEstadoLiquidacion::PAGADA') %}
                                                {% set estadoColor = '#d4edda' %}
                                            {% endif %}
                                            <span class="badge badge-light" style="{% if estadoColor %}background-color: {{ estadoColor }};{% endif %}">{{ detalle.estado }}</span>
                                        {% else %}
                                            -
                                        {% endif %}
                                    </td>
                                    <td class="text-center">
                                        <a href="{{ path('liquidacion_show_semana', {'id': detalle.id}) }}?returnTo={{ app.request.requestUri|url_encode }}"
                                           class="btn btn-sm btn-light-info font-weight-bold" title="VER DETALLE">
                                            <i class="la la-search"></i>
                                        </a>
                                        {% if detalle.estado and detalle.estado.codigoInterno == constant('App\\Entity\\Constants\\ConstanteEstadoLiquidacion::BORRADOR') %}
                                            <a href="#"
                                               class="btn btn-sm btn-light-primary font-weight-bold abrir-modal-semana ml-2"
                                               data-action="{{ path('liquidacion_guardar_semana', {'id': detalle.id}) }}"
                                               data-semana="{{ loop.index }}"
                                               data-apellido="{{ detalle.empleado.apellido }}"
                                               data-nombre="{{ detalle.empleado.nombre }}"
                                               data-sueldo-bruto="{{ detalle.sueldoBruto|replace({'.': ','}) }}"
                                               data-deducciones="{{ detalle.deducciones|replace({'.': ','}) }}"
                                               data-token="{{ csrf_token('guardar_semana_' ~ detalle.id) }}"
                                               data-return="show"
                                               title="EDITAR">
                                                <i class="la la-edit"></i>
                                            </a>
                                            <form method="post" action="{{ path('liquidacion_aprobar', {'id': detalle.id}) }}" class="d-inline ml-2">
                                                <input type="hidden" name="_token" value="{{ csrf_token('aprobar_' ~ detalle.id) }}">
                                                <button type="submit" class="btn btn-sm btn-light-success font-weight-bold btn-aprobar-confirm" data-tipo="hija" data-sueldo-bruto="{{ detalle.sueldoBruto|replace({'.': ','}) }}" title="APROBAR"><i class="la la-check"></i></button>
                                            </form>
                                            <a href="#"
                                               class="btn btn-sm btn-light-dark font-weight-bold abrir-modal-concepto-semana ml-2"
                                               data-action="{{ path('liquidacion_agregar_concepto_semana', {'id': detalle.id}) }}"
                                               data-semana="{{ loop.index }}"
                                               data-apellido="{{ detalle.empleado.apellido }}"
                                               data-nombre="{{ detalle.empleado.nombre }}"
                                               data-token="{{ csrf_token('agregar_concepto_semana_' ~ detalle.id) }}"
                                               title="AGREGAR CONPCEPTO">
                                                <i class="la la-plus"></i>
                                            </a>
                                        {% elseif detalle.estado and detalle.estado.codigoInterno == constant('App\\Entity\\Constants\\ConstanteEstadoLiquidacion::APROBADA') %}
                                            <form method="post" action="{{ path('liquidacion_pagar', {'id': detalle.id}) }}" class="d-inline ml-2">
                                                <input type="hidden" name="pago_empleado[_token]" value="{{ csrf_token('pago_empleado') }}">
                                                <input type="hidden" name="pago_empleado[importe]" value="{{ detalle.totalAPagar|number_format(2, ',', '') }}">
                                                <input type="hidden" name="pago_empleado[fecha]" value="{{ 'now'|date('Y-m-d') }}">
                                                <button type="submit" class="btn btn-sm btn-warning font-weight-bold">Pagar</button>
                                            </form>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                            <tr class="font-weight-bold">
                                <td colspan="3" class="text-right">Total semanas</td>
                                <td class="text-right">{{ liquidacion.sueldoNeto|money_format }}</td>
                                <td class="text-right">{{ liquidacion.totalConceptosSemanas|money_format }}</td>
                                <td colspan="2"></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            {% endif %}

            {{ form_start(form, {'attr': {'class' : 'horizontal-form','novalidate': 'novalidate'} }) }}

                <div class="row mt-8">
                    {% if form.sueldoBruto is defined %}{{ macro_form._new_field(form.sueldoBruto, 'col-md-6') }}{% endif %}
                    {% if form.deducciones is defined %}{{ macro_form._new_field(form.deducciones, 'col-md-6') }}{% endif %}
                    {% if form.observaciones is defined %}{{ macro_form._new_field(form.observaciones, 'col-md-12') }}{% endif %}
                </div>

                {% if liquidacion.detallesSemanales is not empty %}
                    <input type="hidden" id="liquidacion_sueldoBruto" value="{{ liquidacion.sueldoNeto|number_format(2, ',', '.') }}">
                    <input type="hidden" id="liquidacion_deducciones" value="0">
                    <input type="hidden" id="liquidacion_totalConceptosSemanas" value="{{ liquidacion.totalConceptosSemanas|number_format(2, ',', '.') }}">
                {% endif %}

                {% if form.conceptos is defined %}
                    <h5 class="mt-8 mb-3">Conceptos</h5>

                    {% if editable %}
                        <div class="row row-liquidacion-concepto-form align-items-end">
                            <div class="col-md-2">
                                {{ macro_form._new_field(form.concepto.tipoConceptoLiquidacion, '') }}
                            </div>
                            <div class="col-md-3">
                                {{ macro_form._new_field(form.concepto.descripcion, '') }}
                            </div>
                            <div class="col-md-1">
                                {{ macro_form._new_field(form.concepto.cantidad, '') }}
                            </div>
                            <div class="col-md-2">
                                {{ macro_form._new_field(form.concepto.valorUnitario, '') }}
                            </div>
                            <div class="col-md-2">
                                {{ macro_form._new_field(form.concepto.importe, '') }}
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <button type="button" class="btn btn-success font-weight-bold link-add-liquidacion-concepto">
                                        <i class="la la-plus"></i>
                                        AGREGAR CONCEPTO
                                    </button>
                                </div>
                            </div>
                        </div>
                    {% endif %}

                    <div class="row row-liquidacion-concepto-empty margin-top-20" style="display: none;">
                        <div class="col-md-12">
                            <div class="alert alert-danger alert-form-error" style="background-color: #fbe1e3;color: brown;">
                                Debe ingresar al menos un concepto.
                            </div>
                        </div>
                    </div>

                    <div class="row row-liquidacion-conceptos margin-top-15">
                        <div class="col-md-12">
                            <div class="table-scrollable">
                                <table class="table table-striped table-bordered table-advance table-hover">
                                    <thead>
                                        <tr>
                                            <th class="text-center">Concepto</th>
                                            <th class="text-center">Descripción</th>
                                            <th class="text-center">Cantidad</th>
                                            <th class="text-center">Valor unitario</th>
                                            <th class="text-center">Importe</th>
                                            <th class="text-center">Tipo</th>
                                            <th class="nowrap text-center"></th>
                                        </tr>
                                    </thead>
                                    <tbody class="tbody-liquidacion-concepto" data-index="{{ liquidacion.conceptos|length }}">
                                        {% for concepto in liquidacion.conceptos %}
                                            <tr class="tr-liquidacion-concepto" data-total="{{ concepto.importe }}" data-tipo="{{ concepto.tipoConceptoLiquidacion.tipo }}">
                                                <td class="hidden">
                                                    <input type="hidden" name="liquidacion[conceptos][{{ loop.index0 }}][id]" value="{{ concepto.id }}">
                                                </td>
                                                <td class="hidden">
                                                    <input type="hidden" name="liquidacion[conceptos][{{ loop.index0 }}][tipoConceptoLiquidacion]" value="{{ concepto.tipoConceptoLiquidacion.id }}">
                                                </td>
                                                <td class="hidden">
                                                    <input type="hidden" name="liquidacion[conceptos][{{ loop.index0 }}][descripcion]" value="{{ concepto.descripcion }}">
                                                </td>
                                                <td class="hidden">
                                                    <input type="hidden" name="liquidacion[conceptos][{{ loop.index0 }}][cantidad]" value="{{ concepto.cantidad|number_format(2, ',', '.') }}">
                                                </td>
                                                <td class="hidden">
                                                    <input type="hidden" name="liquidacion[conceptos][{{ loop.index0 }}][valorUnitario]" value="{{ concepto.valorUnitario|number_format(2, ',', '.') }}">
                                                </td>
                                                <td class="hidden">
                                                    <input type="hidden" name="liquidacion[conceptos][{{ loop.index0 }}][importe]" value="{{ concepto.importe|number_format(2, ',', '.') }}">
                                                </td>
                                                <td class="v-middle text-center">{{ concepto.tipoConceptoLiquidacion }}</td>
                                                <td class="v-middle text-center">{{ concepto.descripcion|default('-') }}</td>
                                                <td class="v-middle text-center">{{ concepto.cantidad|number_format(2, ',', '.') }}</td>
                                                <td class="v-middle text-center">{{ concepto.valorUnitario|money_format }}</td>
                                                <td class="v-middle text-center">{{ concepto.importe|money_format }}</td>
                                                <td class="v-middle text-center">{{ concepto.tipoConceptoLiquidacion.tipo }}</td>
                                                <td class="text-center v-middle">
                                                    {% if editable %}
                                                        <a href="#" class="btn btn-sm delete-link-inline link-delete-liquidacion-concepto tooltips" data-placement="top" data-original-title="Eliminar">
                                                            <i class="fa fa-trash text-danger"></i>
                                                        </a>
                                                    {% endif %}
                                                </td>
                                            </tr>
                                        {% else %}
                                            <tr>
                                                <td colspan="7" class="text-center text-muted">No se registró ningún concepto</td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                {% endif %}

                <div class="mt-3 font-weight-bold text-right">
                    Sueldo neto: <span id="resumen-neto"></span> &nbsp;|&nbsp;
                    Total a pagar: <span id="resumen-total"></span>
                </div>

                <div class="card-footer d-flex justify-content-between mt-8">
                    <a href="{{ path('liquidacion_index', {'periodo': liquidacion.periodo}) }}" class="btn btn-light-dark font-weight-bold">Volver</a>
                    <div>
                        {{ form_widget(form._token) }}
                        {% if editable %}
                            <input type="hidden" name="accion" value="guardar" id="liquidacion-accion">
                            <button type="submit" class="btn btn-primary font-weight-bold mr-2">Guardar borrador</button>
                            {% if liquidacion.estado and liquidacion.estado.codigoInterno == 1 %}
                                <button type="submit" class="btn btn-success font-weight-bold btn-aprobar-confirm" data-tipo="principal">Aprobar</button>
                            {% endif %}
                        {% endif %}
                        {% if liquidacion.estado and liquidacion.estado.codigoInterno == 3 %}
                            <button type="button" class="btn btn-warning font-weight-bold mr-2" data-toggle="modal" data-target="#pagoModal">
                                Pagar
                            </button>
                        {% endif %}
                        {% if liquidacion.padre is null and liquidacion.estado and liquidacion.estado.codigoInterno == 4 %}
                            <button type="button"
                                    class="btn btn-danger font-weight-bold btn-revertir-confirm"
                                    data-action="{{ path('liquidacion_revertir', {'id': liquidacion.id}) }}"
                                    data-token="{{ csrf_token('revertir_' ~ liquidacion.id) }}">
                                Revertir pago
                            </button>
                        {% endif %}
                        {{ form_end(form, {'render_rest': false}) }}
                    </div>
                </div>


        </div>
    </div>

    {% if liquidacion.estado and liquidacion.estado.codigoInterno == 3 %}
        <div class="modal fade" id="pagoModal" tabindex="-1" role="dialog" aria-labelledby="pagoModalLabel" aria-hidden="true">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="pagoModalLabel">Registrar pago</h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <i aria-hidden="true" class="ki ki-close"></i>
                        </button>
                    </div>
                    {{ form_start(pagoForm, {'attr': {'class' : 'horizontal-form','novalidate': 'novalidate'} }) }}
                    <div class="modal-body">
                        <div class="row">
                            {{ macro_form._new_field(pagoForm.importe, 'col-md-6') }}
                            {{ macro_form._new_field(pagoForm.fecha, 'col-md-6') }}
                        </div>
                        <div class="row">
                            {{ macro_form._new_field(pagoForm.observaciones, 'col-md-12') }}
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light-primary font-weight-bold" data-dismiss="modal">Cerrar</button>
                        {{ form_widget(pagoForm._token) }}
                        <button type="submit" class="btn btn-success font-weight-bold">Registrar pago</button>
                    </div>
                    {{ form_end(pagoForm, {'render_rest': false}) }}
                </div>
            </div>
        </div>
    {% endif %}

    {% include 'liquidacion/_modal_semana.html.twig' %}
    {% include 'liquidacion/_modal_concepto_semana.html.twig' %}

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset(__PREFIX_JAVASCRIPT__ ~ 'app/liquidacion/show.js') }}"></script>
    <script>
        function parseSueldoBruto(valor) {
            if (!valor) return 0;
            return parseFloat(valor.replace(/\./g, '').replace(',', '.'));
        }

        function aprobarConConfirmacion(btn, callback) {
            var sueldoBruto = null;
            var tipo = btn.getAttribute('data-tipo');

            if (tipo === 'principal') {
                var input = document.querySelector('[name="liquidacion[sueldoBruto]"]');
                if (input) {
                    sueldoBruto = parseSueldoBruto(input.value);
                }
            } else if (tipo === 'hija') {
                sueldoBruto = parseSueldoBruto(btn.getAttribute('data-sueldo-bruto'));
            }

            if (sueldoBruto !== null && sueldoBruto === 0) {
                Swal.fire({
                    title: 'Advertencia',
                    text: 'La liquidación tiene sueldo bruto igual a 0. ¿Desea aprobar de todas formas?',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Sí, aprobar',
                    cancelButtonText: 'Cancelar',
                    confirmButtonColor: '#28a745',
                    cancelButtonColor: '#dc3545'
                }).then(function(result) {
                    if (result.isConfirmed) {
                        callback();
                    }
                });
            } else {
                callback();
            }
        }

        document.querySelectorAll('.btn-aprobar-confirm').forEach(function(btn) {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                var form = btn.closest('form');
                aprobarConConfirmacion(btn, function() {
                    if (btn.getAttribute('data-tipo') === 'principal') {
                        document.getElementById('liquidacion-accion').value = 'aprobar';
                    }
                    if (form) {
                        form.submit();
                    } else {
                        btn.closest('form').submit();
                    }
                });
            });
        });
    </script>
{% endblock %}
