{% extends 'base.html.twig' %}

{% block body %}

    <div class="card card-custom">
        <div class="card-header">
            <div class="card-title">
                <span class="card-icon"><i class="flaticon-search text-primary"></i></span>
                <h3 class="card-label">Detalle de semana — {{ liquidacion.empleado.nombreCompleto }} ({{ liquidacion.periodo }})</h3>
            </div>
            <div class="card-toolbar">
                <span class="badge badge-info mr-3">{{ liquidacion.estado }}</span>
            </div>
        </div>

        <div class="card-body">

            <!-- Cabecera -->
            <div class="d-flex align-items-center justify-content-between flex-wrap mb-8">
                <div class="d-flex align-items-center">
                    <div class="symbol symbol-60 symbol-light-primary mr-5">
                        <span class="symbol-label font-size-h3">{{ liquidacion.empleado.nombreCompleto|first|upper }}</span>
                    </div>
                    <div>
                        <h3 class="mb-1">{{ liquidacion.empleado.nombreCompleto }}</h3>
                        <span class="text-muted">Período: {{ liquidacion.periodo }}</span><br>
                        <span class="text-muted">Desde: {{ liquidacion.fechaDesde ? liquidacion.fechaDesde|date('d/m/Y') : '-' }} · Hasta: {{ liquidacion.fechaHasta ? liquidacion.fechaHasta|date('d/m/Y') : '-' }}</span><br>
                        <span class="text-muted">Modalidad: {{ liquidacion.tipoModalidadPago ? liquidacion.tipoModalidadPago.nombre : '-' }}</span>
                    </div>
                </div>
            </div>

            <h5 class="mt-8 mb-3">Resumen</h5>
            <div class="table-responsive">
                <table class="table table-bordered table-hover">
                    <thead>
                        <tr>
                            <th class="text-center">Sueldo bruto</th>
                            <th class="text-center">Deducciones</th>
                            <th class="text-center">Sueldo neto</th>
                            <th class="text-center">Conceptos</th>
                            <th class="text-center">Total a pagar</th>
                            <th class="text-center">Total pagado</th>
                            <th class="text-center">Restante</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="text-center">{{ liquidacion.sueldoBruto|money_format }}</td>
                            <td class="text-center">{{ liquidacion.deducciones|money_format }}</td>
                            <td class="text-center">{{ liquidacion.sueldoNeto|money_format }}</td>
                            <td class="text-center">{{ liquidacion.totalConceptos|money_format }}</td>
                            <td class="text-center">{{ liquidacion.totalAPagar|money_format }}</td>
                            <td class="text-center">{{ totalPagado|money_format }}</td>
                            <td class="text-center">{{ restante|money_format }}</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <h5 class="mt-8 mb-3">Conceptos</h5>
            <div class="table-responsive">
                <table class="table table-striped table-bordered table-advance table-hover">
                    <thead>
                        <tr>
                            <th class="text-center">Concepto</th>
                            <th class="text-center">Descripción</th>
                            <th class="text-center">Cantidad</th>
                            <th class="text-center">Valor unitario</th>
                            <th class="text-center">Importe</th>
                            <th class="text-center">Tipo</th>
                            {% if editable %}
                                <th class="text-center">Acciones</th>
                            {% endif %}
                        </tr>
                    </thead>
                    <tbody>
                        {% for concepto in liquidacion.conceptos %}
                            <tr>
                                <td class="v-middle text-center">{{ concepto.tipoConceptoLiquidacion }}</td>
                                <td class="v-middle text-center">{{ concepto.descripcion|default('-') }}</td>
                                <td class="v-middle text-center">{{ concepto.cantidad|number_format(2, ',', '.') }}</td>
                                <td class="v-middle text-center">{{ concepto.valorUnitario|money_format }}</td>
                                <td class="v-middle text-center">{{ concepto.importe|money_format }}</td>
                                <td class="v-middle text-center">{{ concepto.tipoConceptoLiquidacion.tipo }}</td>
                                {% if editable %}
                                    <td class="v-middle text-center">
                                        <form method="post" action="{{ path('liquidacion_concepto_eliminar', {'id': concepto.id}) }}" class="d-inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('eliminar_concepto_' ~ concepto.id) }}">
                                            <input type="hidden" name="returnTo" value="{{ returnTo }}">
                                            <button type="submit" class="btn btn-sm btn-light-danger btn-eliminar-concepto-semana" title="ELIMINAR">
                                                <i class="la la-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                {% endif %}
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="{{ editable ? 7 : 6 }}" class="text-center text-muted">No se registró ningún concepto</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            {% if liquidacion.pagos is not empty %}
                <h5 class="mt-8 mb-3">Pagos</h5>
                <div class="table-responsive">
                    <table class="table table-striped table-bordered table-advance table-hover">
                        <thead>
                            <tr>
                                <th class="text-center">Fecha</th>
                                <th class="text-center">Importe</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for pago in liquidacion.pagos %}
                                <tr>
                                    <td class="text-center">{{ pago.fecha ? pago.fecha|date('d/m/Y') : '-' }}</td>
                                    <td class="text-center">{{ pago.importe|money_format }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>

        <div class="card-footer d-flex justify-content-between">
            {% if returnTo %}
                <a href="{{ returnTo }}" class="btn btn-light-dark font-weight-bold">Volver</a>
            {% else %}
                <a href="{{ path('liquidacion_show', {'id': liquidacion.padre.id}) }}" class="btn btn-light-dark font-weight-bold">Volver</a>
            {% endif %}
        </div>
    </div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset(__PREFIX_JAVASCRIPT__ ~ 'app/liquidacion/show.js') }}"></script>
{% endblock %}
